{% doc %}
  @prompt
    can you add like a aesthetic line to break the top block and bottom one
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-divider-container-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.spacing_top }}px 0 {{ block.settings.spacing_bottom }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-divider-line-{{ ai_gen_id }} {
    width: {{ block.settings.line_width }}%;
    height: {{ block.settings.line_thickness }}px;
    background: {{ block.settings.line_color }};
    border-radius: {{ block.settings.line_border_radius }}px;
    position: relative;
    overflow: hidden;
  }

  {% if block.settings.line_style == 'gradient' %}
    .ai-divider-line-{{ ai_gen_id }} {
      background: linear-gradient(90deg, 
        transparent 0%, 
        {{ block.settings.line_color }} 20%, 
        {{ block.settings.line_color }} 80%, 
        transparent 100%
      );
    }
  {% endif %}

  {% if block.settings.line_style == 'dotted' %}
    .ai-divider-line-{{ ai_gen_id }} {
      background: repeating-linear-gradient(
        90deg,
        {{ block.settings.line_color }} 0px,
        {{ block.settings.line_color }} {{ block.settings.line_thickness | times: 2 }}px,
        transparent {{ block.settings.line_thickness | times: 2 }}px,
        transparent {{ block.settings.line_thickness | times: 4 }}px
      );
    }
  {% endif %}

  {% if block.settings.line_style == 'dashed' %}
    .ai-divider-line-{{ ai_gen_id }} {
      background: repeating-linear-gradient(
        90deg,
        {{ block.settings.line_color }} 0px,
        {{ block.settings.line_color }} {{ block.settings.line_thickness | times: 6 }}px,
        transparent {{ block.settings.line_thickness | times: 6 }}px,
        transparent {{ block.settings.line_thickness | times: 10 }}px
      );
    }
  {% endif %}

  {% if block.settings.show_center_element %}
    .ai-divider-with-element-{{ ai_gen_id }} {
      display: flex;
      align-items: center;
      gap: {{ block.settings.element_spacing }}px;
    }

    .ai-divider-side-line-{{ ai_gen_id }} {
      flex: 1;
      height: {{ block.settings.line_thickness }}px;
      background: {{ block.settings.line_color }};
      border-radius: {{ block.settings.line_border_radius }}px;
    }

    .ai-divider-center-element-{{ ai_gen_id }} {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .ai-divider-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size }}px;
      height: {{ block.settings.icon_size }}px;
      color: {{ block.settings.icon_color }};
    }

    .ai-divider-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size }}px;
      color: {{ block.settings.text_color }};
      font-weight: {{ block.settings.text_weight }};
      text-transform: {% if block.settings.text_uppercase %}uppercase{% else %}none{% endif %};
      letter-spacing: {{ block.settings.text_letter_spacing }}px;
      white-space: nowrap;
    }

    .ai-divider-circle-{{ ai_gen_id }} {
      width: {{ block.settings.circle_size }}px;
      height: {{ block.settings.circle_size }}px;
      background-color: {{ block.settings.circle_color }};
      border-radius: 50%;
      border: {{ block.settings.circle_border_width }}px solid {{ block.settings.circle_border_color }};
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-divider-container-{{ ai_gen_id }} {
      padding: {{ block.settings.spacing_top | times: 0.7 | round }}px 0 {{ block.settings.spacing_bottom | times: 0.7 | round }}px;
    }

    .ai-divider-line-{{ ai_gen_id }} {
      width: {{ block.settings.line_width | at_least: 90 }}%;
    }

    {% if block.settings.show_center_element %}
      .ai-divider-with-element-{{ ai_gen_id }} {
        gap: {{ block.settings.element_spacing | times: 0.8 | round }}px;
      }

      .ai-divider-text-{{ ai_gen_id }} {
        font-size: {{ block.settings.text_size | times: 0.9 | round }}px;
      }

      .ai-divider-icon-{{ ai_gen_id }} {
        width: {{ block.settings.icon_size | times: 0.9 | round }}px;
        height: {{ block.settings.icon_size | times: 0.9 | round }}px;
      }

      .ai-divider-circle-{{ ai_gen_id }} {
        width: {{ block.settings.circle_size | times: 0.9 | round }}px;
        height: {{ block.settings.circle_size | times: 0.9 | round }}px;
      }
    {% endif %}
  }
{% endstyle %}

<div class="ai-divider-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_center_element %}
    <div class="ai-divider-with-element-{{ ai_gen_id }}">
      <div class="ai-divider-side-line-{{ ai_gen_id }}"></div>
      
      <div class="ai-divider-center-element-{{ ai_gen_id }}">
        {% case block.settings.center_element_type %}
          {% when 'text' %}
            {% if block.settings.center_text != blank %}
              <span class="ai-divider-text-{{ ai_gen_id }}">{{ block.settings.center_text }}</span>
            {% endif %}
          
          {% when 'icon' %}
            {% case block.settings.icon_type %}
              {% when 'star' %}
                <svg class="ai-divider-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% when 'diamond' %}
                <svg class="ai-divider-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M6 3h12l4 6-10 12L2 9l4-6z"/>
                </svg>
              {% when 'heart' %}
                <svg class="ai-divider-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              {% when 'flower' %}
                <svg class="ai-divider-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
              {% when 'leaf' %}
                <svg class="ai-divider-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75S7 8 17 8z"/>
                </svg>
            {% endcase %}
          
          {% when 'circle' %}
            <div class="ai-divider-circle-{{ ai_gen_id }}"></div>
        {% endcase %}
      </div>
      
      <div class="ai-divider-side-line-{{ ai_gen_id }}"></div>
    </div>
  {% else %}
    <div class="ai-divider-line-{{ ai_gen_id }}"></div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Aesthetic divider",
  "settings": [
    {
      "type": "header",
      "content": "Line style"
    },
    {
      "type": "select",
      "id": "line_style",
      "label": "Line style",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "gradient",
          "label": "Gradient fade"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        }
      ],
      "default": "solid"
    },
    {
      "type": "range",
      "id": "line_width",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Line width",
      "default": 80
    },
    {
      "type": "range",
      "id": "line_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Line thickness",
      "default": 2
    },
    {
      "type": "range",
      "id": "line_border_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Line border radius",
      "default": 0
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#d1cdc4"
    },
    {
      "type": "header",
      "content": "Center element"
    },
    {
      "type": "checkbox",
      "id": "show_center_element",
      "label": "Show center element",
      "default": false
    },
    {
      "type": "select",
      "id": "center_element_type",
      "label": "Element type",
      "options": [
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "icon",
          "label": "Icon"
        },
        {
          "value": "circle",
          "label": "Circle"
        }
      ],
      "default": "text"
    },
    {
      "type": "range",
      "id": "element_spacing",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Element spacing",
      "default": 20
    },
    {
      "type": "header",
      "content": "Text element"
    },
    {
      "type": "text",
      "id": "center_text",
      "label": "Center text",
      "default": "✦"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Text size",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#211f20"
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "checkbox",
      "id": "text_uppercase",
      "label": "Uppercase text",
      "default": false
    },
    {
      "type": "range",
      "id": "text_letter_spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "label": "Letter spacing",
      "default": 0
    },
    {
      "type": "header",
      "content": "Icon element"
    },
    {
      "type": "select",
      "id": "icon_type",
      "label": "Icon type",
      "options": [
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "diamond",
          "label": "Diamond"
        },
        {
          "value": "heart",
          "label": "Heart"
        },
        {
          "value": "flower",
          "label": "Flower"
        },
        {
          "value": "leaf",
          "label": "Leaf"
        }
      ],
      "default": "star"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 20
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#211f20"
    },
    {
      "type": "header",
      "content": "Circle element"
    },
    {
      "type": "range",
      "id": "circle_size",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Circle size",
      "default": 12
    },
    {
      "type": "color",
      "id": "circle_color",
      "label": "Circle color",
      "default": "#d1cdc4"
    },
    {
      "type": "range",
      "id": "circle_border_width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Circle border width",
      "default": 0
    },
    {
      "type": "color",
      "id": "circle_border_color",
      "label": "Circle border color",
      "default": "#211f20"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top spacing",
      "default": 40
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Aesthetic divider"
    }
  ]
}
{% endschema %}