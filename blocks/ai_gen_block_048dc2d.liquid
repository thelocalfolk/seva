{% doc %}
  @prompt
    Create a flexible content section with a small image on the left side and a large text area on the right side. The layout should be responsive and allow for storytelling with ample space for text content. Include customization options for image size, text formatting, and spacing.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-content-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-content-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-content-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-content-image-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.image_width }}%;
    max-width: {{ block.settings.image_width }}%;
  }

  .ai-content-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-content-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-content-image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-content-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-content-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-content-text-{{ ai_gen_id }} {
    flex: 1;
    padding: {{ block.settings.text_padding_top }}px {{ block.settings.text_padding_right }}px {{ block.settings.text_padding_bottom }}px {{ block.settings.text_padding_left }}px;
  }

  .ai-content-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    line-height: {{ block.settings.heading_line_height }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    {% if block.settings.heading_uppercase %}text-transform: uppercase;{% endif %}
    {% if block.settings.heading_letter_spacing != 0 %}letter-spacing: {{ block.settings.heading_letter_spacing }}px;{% endif %}
  }

  .ai-content-text-content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.text_line_height }};
    {% if block.settings.text_letter_spacing != 0 %}letter-spacing: {{ block.settings.text_letter_spacing }}px;{% endif %}
  }

  .ai-content-text-content-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px;
  }

  .ai-content-text-content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-content-button-{{ ai_gen_id }} {
    display: inline-block;
    margin-top: {{ block.settings.button_margin_top }}px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    transition: all 0.3s ease;
    {% if block.settings.button_uppercase %}text-transform: uppercase;{% endif %}
    {% if block.settings.button_letter_spacing != 0 %}letter-spacing: {{ block.settings.button_letter_spacing }}px;{% endif %}
  }

  .ai-content-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-content-wrapper-{{ ai_gen_id }} {
      flex-direction: {% if block.settings.mobile_layout == 'image_top' %}column{% else %}column-reverse{% endif %};
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-content-image-{{ ai_gen_id }} {
      flex: none;
      max-width: 100%;
    }

    .ai-content-text-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_text_padding }}px 0;
    }

    .ai-content-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-content-text-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }

    .ai-content-section-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_section_padding }}px 0;
    }
  }
{% endstyle %}

<div
  class="ai-content-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-content-container-{{ ai_gen_id }}">
    <div class="ai-content-wrapper-{{ ai_gen_id }}">
      <div class="ai-content-image-{{ ai_gen_id }}">
        <div class="ai-content-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {% else %}
            <div class="ai-content-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-content-empty-state-{{ ai_gen_id }}">
                Add an image to get started
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-content-text-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-content-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.text_content != blank %}
          <div class="ai-content-text-content-{{ ai_gen_id }}">
            {{ block.settings.text_content }}
          </div>
        {% endif %}

        {% if block.settings.button_text != blank and block.settings.button_link != blank %}
          <a
            href="{{ block.settings.button_link }}"
            class="ai-content-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
