{% doc %}
  @prompt
    Create a responsive video section that can display Vimeo and YouTube videos with customizable sizing, alignment options, and mobile-friendly design

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-video-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-video-content-{{ ai_gen_id }} {
    text-align: {{ block.settings.alignment }};
  }

  .ai-video-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.heading_margin }}px;
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-video-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.description_margin }}px;
    font-size: {{ block.settings.description_size }}px;
  }

  .ai-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: {{ block.settings.video_max_width }}px;
    margin: 0 auto;
    background-color: #000;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-video-aspect-ratio-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: {{ block.settings.aspect_ratio }}%;
  }

  .ai-video-iframe-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-video-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    color: #666;
    font-size: 16px;
  }

  .ai-video-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.5;
  }

  .ai-video-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 6px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-video-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 0 {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-video-container-{{ ai_gen_id }} {
      padding: 0 15px;
    }

    .ai-video-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-video-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-video-wrapper-{{ ai_gen_id }} {
      max-width: 100%;
    }

    {% if block.settings.mobile_aspect_ratio != 'same' %}
      .ai-video-aspect-ratio-{{ ai_gen_id }} {
        padding-bottom: {{ block.settings.mobile_aspect_ratio }}%;
      }
    {% endif %}
  }
{% endstyle %}

<div class="ai-video-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-container-{{ ai_gen_id }}">
    <div class="ai-video-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-video-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-video-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}

      <div class="ai-video-wrapper-{{ ai_gen_id }}">
        <div class="ai-video-aspect-ratio-{{ ai_gen_id }}">
          {% if block.settings.video_url != blank %}
            {% liquid
              assign video_id = ''
              assign video_provider = ''
              
              if block.settings.video_url contains 'youtube.com/watch'
                assign video_id = block.settings.video_url | split: 'v=' | last | split: '&' | first
                assign video_provider = 'youtube'
              elsif block.settings.video_url contains 'youtu.be/'
                assign video_id = block.settings.video_url | split: 'youtu.be/' | last | split: '?' | first
                assign video_provider = 'youtube'
              elsif block.settings.video_url contains 'vimeo.com/'
                assign video_id = block.settings.video_url | split: 'vimeo.com/' | last | split: '?' | first
                assign video_provider = 'vimeo'
              endif
            %}

            {% if video_provider == 'youtube' and video_id != blank %}
              <iframe
                class="ai-video-iframe-{{ ai_gen_id }}"
                src="https://www.youtube.com/embed/{{ video_id }}?rel=0&modestbranding=1"
                title="YouTube video player"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            {% elsif video_provider == 'vimeo' and video_id != blank %}
              <iframe
                class="ai-video-iframe-{{ ai_gen_id }}"
                src="https://player.vimeo.com/video/{{ video_id }}?title=0&byline=0&portrait=0"
                title="Vimeo video player"
                frameborder="0"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            {% else %}
              <div class="ai-video-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
                <div class="ai-video-empty-state-{{ ai_gen_id }}">
                  Please enter a valid YouTube or Vimeo URL
                </div>
              </div>
            {% endif %}
          {% else %}
            <div class="ai-video-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-video-empty-state-{{ ai_gen_id }}">
                Add a video URL to get started
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Video section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Watch our video"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover more about our story and products in this video.</p>"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL",
      "info": "Supports YouTube and Vimeo URLs"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Section max width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "video_max_width",
      "min": 400,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Video max width",
      "default": 800
    },
    {
      "type": "header",
      "content": "Video sizing"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        {
          "value": "75",
          "label": "4:3 (75%)"
        },
        {
          "value": "56.25",
          "label": "16:9 (56.25%)"
        },
        {
          "value": "66.67",
          "label": "3:2 (66.67%)"
        },
        {
          "value": "50",
          "label": "2:1 (50%)"
        }
      ],
      "default": "56.25"
    },
    {
      "type": "select",
      "id": "mobile_aspect_ratio",
      "label": "Mobile aspect ratio",
      "options": [
        {
          "value": "same",
          "label": "Same as desktop"
        },
        {
          "value": "75",
          "label": "4:3 (75%)"
        },
        {
          "value": "56.25",
          "label": "16:9 (56.25%)"
        },
        {
          "value": "100",
          "label": "1:1 (100%)"
        }
      ],
      "default": "same"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section padding bottom",
      "default": 50
    },
    {
      "type": "range",
      "id": "heading_margin",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Heading bottom margin",
      "default": 20
    },
    {
      "type": "range",
      "id": "description_margin",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Description bottom margin",
      "default": 30
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Video section"
    }
  ]
}
{% endschema %}