{% doc %}
  @prompt
    Create a simple logo section that displays a customizable logo image centered between other sections, with options to adjust the logo size and add padding around it

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-section-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    text-align: center;
    background-color: {{ block.settings.background_color }};
  }

  .ai-logo-container-{{ ai_gen_id }} {
    display: inline-block;
    max-width: 100%;
  }

  .ai-logo-image-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: auto;
    max-width: 100%;
    display: block;
  }

  .ai-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: auto;
    max-width: 100%;
    display: inline-block;
  }

  .ai-logo-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
    opacity: 0.6;
  }

  @media screen and (max-width: 749px) {
    .ai-logo-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px 0 {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-logo-image-{{ ai_gen_id }},
    .ai-logo-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-logo-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-logo-container-{{ ai_gen_id }}">
    {% if block.settings.logo_image %}
      {% if block.settings.logo_link %}
        <a href="{{ block.settings.logo_link }}">
          <img
            src="{{ block.settings.logo_image | image_url: width: 800 }}"
            alt="{{ block.settings.logo_image.alt | default: shop.name | escape }}"
            class="ai-logo-image-{{ ai_gen_id }}"
            width="{{ block.settings.logo_image.width }}"
            height="{{ block.settings.logo_image.height }}"
            loading="lazy"
          >
        </a>
      {% else %}
        <img
          src="{{ block.settings.logo_image | image_url: width: 800 }}"
          alt="{{ block.settings.logo_image.alt | default: shop.name | escape }}"
          class="ai-logo-image-{{ ai_gen_id }}"
          width="{{ block.settings.logo_image.width }}"
          height="{{ block.settings.logo_image.height }}"
          loading="lazy"
        >
      {% endif %}
    {% else %}
      <div class="ai-logo-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Logo section",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image"
    },
    {
      "type": "url",
      "id": "logo_link",
      "label": "Logo link"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Desktop width",
      "default": 200
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Mobile width",
      "default": 150
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 30
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Logo section"
    }
  ],
  "tag": null
}
{% endschema %}