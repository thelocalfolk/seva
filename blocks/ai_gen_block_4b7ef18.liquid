{% doc %}
  @prompt
    Remove white background from video embed and make it transparent or match the section background. Add CSS styling to eliminate any white padding or background around the video iframe.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-embed-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    background: transparent;
    padding: 0;
    margin: 0;
  }

  .ai-video-embed-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: {{ block.settings.aspect_ratio }}%;
    background: transparent;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-video-embed-iframe-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    display: block;
  }

  .ai-video-embed-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 400px;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border-radius: {{ block.settings.border_radius }}px;
    border: 2px dashed #ccc;
  }

  .ai-video-embed-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  .ai-video-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 6px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-video-embed-wrapper-{{ ai_gen_id }} {
      padding-bottom: {{ block.settings.mobile_aspect_ratio }}%;
    }
  }
{% endstyle %}

<div class="ai-video-embed-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.video_url != blank %}
    {% liquid
      assign video_url = block.settings.video_url
      assign video_id = ''
      assign embed_url = ''
      
      if video_url contains 'youtube.com/watch'
        assign video_id = video_url | split: 'v=' | last | split: '&' | first
        assign embed_url = 'https://www.youtube.com/embed/' | append: video_id | append: '?rel=0&modestbranding=1&autohide=1&showinfo=0&controls=1&transparent=1'
      elsif video_url contains 'youtu.be/'
        assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first
        assign embed_url = 'https://www.youtube.com/embed/' | append: video_id | append: '?rel=0&modestbranding=1&autohide=1&showinfo=0&controls=1&transparent=1'
      elsif video_url contains 'vimeo.com'
        assign video_id = video_url | split: 'vimeo.com/' | last | split: '?' | first
        assign embed_url = 'https://player.vimeo.com/video/' | append: video_id | append: '?transparent=1&background=1'
      endif
      
      if block.settings.autoplay
        if embed_url contains 'youtube'
          assign embed_url = embed_url | append: '&autoplay=1&mute=1'
        elsif embed_url contains 'vimeo'
          assign embed_url = embed_url | append: '&autoplay=1&muted=1'
        endif
      endif
      
      if block.settings.loop
        if embed_url contains 'youtube'
          assign embed_url = embed_url | append: '&loop=1&playlist=' | append: video_id
        elsif embed_url contains 'vimeo'
          assign embed_url = embed_url | append: '&loop=1'
        endif
      endif
    %}
    
    {% if embed_url != blank %}
      <div class="ai-video-embed-wrapper-{{ ai_gen_id }}">
        <iframe
          class="ai-video-embed-iframe-{{ ai_gen_id }}"
          src="{{ embed_url }}"
          title="{{ block.settings.video_title | default: 'Video' | escape }}"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    {% endif %}
  {% else %}
    <div class="ai-video-embed-placeholder-{{ ai_gen_id }}">
      {{ 'image' | placeholder_svg_tag }}
      <div class="ai-video-empty-state-{{ ai_gen_id }}">
        Add a YouTube or Vimeo video URL
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Transparent video embed",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL",
      "info": "Supports YouTube and Vimeo URLs"
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "Video title",
      "default": "Video"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay video",
      "default": false,
      "info": "Videos will be muted when autoplaying"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop video",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        {
          "value": "75",
          "label": "4:3"
        },
        {
          "value": "56.25",
          "label": "16:9"
        },
        {
          "value": "42.86",
          "label": "21:9"
        },
        {
          "value": "100",
          "label": "1:1"
        }
      ],
      "default": "56.25"
    },
    {
      "type": "select",
      "id": "mobile_aspect_ratio",
      "label": "Mobile aspect ratio",
      "options": [
        {
          "value": "75",
          "label": "4:3"
        },
        {
          "value": "56.25",
          "label": "16:9"
        },
        {
          "value": "100",
          "label": "1:1"
        },
        {
          "value": "133.33",
          "label": "3:4"
        }
      ],
      "default": "75"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Transparent video embed"
    }
  ],
  "tag": null
}
{% endschema %}