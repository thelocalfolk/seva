{% doc %}
  @prompt
    Create a customizable video section that supports YouTube embed codes and iframes. Include settings for video size (small, medium, large, full width) and alignment options (left, center, right). The section should be responsive and include proper styling for different screen sizes. Add theme settings for video width, height ratio, and positioning controls.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-section-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-video-container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-video-wrapper-{{ ai_gen_id }} {
    {% case block.settings.video_size %}
      {% when 'small' %}
        max-width: 400px;
      {% when 'medium' %}
        max-width: 600px;
      {% when 'large' %}
        max-width: 800px;
      {% when 'full' %}
        max-width: 100%;
    {% endcase %}
    
    {% case block.settings.alignment %}
      {% when 'left' %}
        margin: 0 auto 0 0;
      {% when 'center' %}
        margin: 0 auto;
      {% when 'right' %}
        margin: 0 0 0 auto;
    {% endcase %}
    
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: {{ block.settings.aspect_ratio }}%;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    box-shadow: {{ block.settings.shadow_intensity }}px {{ block.settings.shadow_intensity }}px {{ block.settings.shadow_intensity | times: 2 }}px rgba(0, 0, 0, 0.1);
  }

  .ai-video-iframe-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-video-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #666;
  }

  .ai-video-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    margin-bottom: 16px;
    opacity: 0.5;
  }

  .ai-video-empty-state-{{ ai_gen_id }} {
    font-size: 14px;
    text-align: center;
    padding: 0 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-video-container-{{ ai_gen_id }} {
      padding: 0 16px;
    }
    
    .ai-video-wrapper-{{ ai_gen_id }} {
      {% case block.settings.mobile_size %}
        {% when 'small' %}
          max-width: 300px;
        {% when 'medium' %}
          max-width: 400px;
        {% when 'large' %}
          max-width: 500px;
        {% when 'full' %}
          max-width: 100%;
      {% endcase %}
    }
  }
{% endstyle %}

<video-section-{{ ai_gen_id }}
  class="ai-video-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-container-{{ ai_gen_id }}">
    <div class="ai-video-wrapper-{{ ai_gen_id }}">
      {% if block.settings.video_embed != blank %}
        <iframe
          class="ai-video-iframe-{{ ai_gen_id }}"
          src="{{ block.settings.video_embed }}"
          title="Video player"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      {% else %}
        <div class="ai-video-placeholder-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="5,3 19,12 5,21"></polygon>
          </svg>
          <div class="ai-video-empty-state-{{ ai_gen_id }}">
            Add your YouTube embed URL or iframe source
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</video-section-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupVideoEmbed();
      }

      setupVideoEmbed() {
        const iframe = this.querySelector('.ai-video-iframe-{{ ai_gen_id }}');
        if (iframe) {
          iframe.addEventListener('load', () => {
            iframe.style.opacity = '1';
          });
        }
      }
    }

    customElements.define('video-section-{{ ai_gen_id }}', VideoSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Video section",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "url",
      "id": "video_embed",
      "label": "Video embed URL",
      "info": "YouTube embed URL or iframe source (e.g., https://www.youtube.com/embed/VIDEO_ID)"
    },
    {
      "type": "select",
      "id": "video_size",
      "label": "Video size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "mobile_size",
      "label": "Mobile size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "aspect_ratio",
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Aspect ratio",
      "default": 55,
      "info": "Lower values create wider videos, higher values create taller videos"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "shadow_intensity",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Shadow intensity",
      "default": 2
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Video section"
    }
  ],
  "tag": null
}
{% endschema %}