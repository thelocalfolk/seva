{% doc %}
  @prompt
    Convert a heading element to a block quote with proper styling and formatting

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blockquote-{{ ai_gen_id }} {
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-left: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-style: {{ block.settings.font_style }};
    color: {{ block.settings.text_color }};
    position: relative;
  }

  .ai-blockquote-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    line-height: {{ block.settings.line_height }};
    margin: 0;
    text-align: {{ block.settings.text_alignment }};
    font-weight: {{ block.settings.font_weight }};
  }

  .ai-blockquote-citation-{{ ai_gen_id }} {
    margin-top: {{ block.settings.citation_spacing }}px;
    font-size: {{ block.settings.citation_font_size }}px;
    color: {{ block.settings.citation_color }};
    text-align: {{ block.settings.citation_alignment }};
    font-style: normal;
  }

  .ai-blockquote-citation-{{ ai_gen_id }}::before {
    content: "— ";
  }

  {% if block.settings.show_quote_marks %}
    .ai-blockquote-{{ ai_gen_id }}::before,
    .ai-blockquote-{{ ai_gen_id }}::after {
      font-size: {{ block.settings.quote_mark_size }}px;
      color: {{ block.settings.quote_mark_color }};
      font-family: serif;
      line-height: 1;position: absolute;
    }

    .ai-blockquote-{{ ai_gen_id }}::before {
      content: """;
      top: {{ block.settings.padding_vertical }}px;
      left: {{ block.settings.padding_horizontal }}px;
      transform: translateY(-50%);
    }

    .ai-blockquote-{{ ai_gen_id }}::after {
      content: """;
      bottom: {{ block.settings.padding_vertical }}px;
      right: {{ block.settings.padding_horizontal }}px;
      transform: translateY(50%);
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-blockquote-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }

    .ai-blockquote-citation-{{ ai_gen_id }} {
      font-size: {{ block.settings.citation_font_size_mobile }}px;
    }

    {% if block.settings.show_quote_marks %}
      .ai-blockquote-{{ ai_gen_id }}::before,
      .ai-blockquote-{{ ai_gen_id }}::after {
        font-size: {{ block.settings.quote_mark_size_mobile }}px;
      }
    {% endif %}
  }
{% endstyle %}

<blockquote
  class="ai-blockquote-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.quote_text != blank %}
    <p class="ai-blockquote-text-{{ ai_gen_id }}">
      {{ block.settings.quote_text }}
    </p>
  {% else %}
    <p class="ai-blockquote-text-{{ ai_gen_id }}" style="color: #999; font-style: italic;">
      Add your quote text here
    </p>
  {% endif %}

  {% if block.settings.citation != blank %}
    <cite class="ai-blockquote-citation-{{ ai_gen_id }}">
      {{ block.settings.citation }}
    </cite>
  {% endif %}
</blockquote>

