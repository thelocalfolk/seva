{% doc %}
  @prompt
    Create a customizable theme section for embedding Vimeo videos with full audio support. The section should allow merchants to input a Vimeo video URL or embed code, display the video responsively, and include settings for video title, autoplay options, and responsive sizing. Ensure the embedded video maintains its audio capabilities and includes proper iframe attributes for Vimeo player functionality.- make sure theres no black background- should be transluecent

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-vimeo-video-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    background: transparent;
  }

  .ai-vimeo-video-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: calc(100% / {{ block.settings.aspect_ratio }});
    background: transparent;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-vimeo-video-iframe-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
    background: transparent;
  }

  .ai-vimeo-video-title-{{ ai_gen_id }} {
    text-align: {{ block.settings.title_alignment }};
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin-bottom: 20px;
    margin-top: 0;
  }

  .ai-vimeo-video-placeholder-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(244, 244, 244, 0.1);
    border: 2px dashed rgba(200, 200, 200, 0.3);
    border-radius: {{ block.settings.border_radius }}px;
    min-height: 300px;
    position: relative;
  }

  .ai-vimeo-video-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  .ai-vimeo-video-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: rgba(102, 102, 102, 0.7);
    text-align: center;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-vimeo-video-container-{{ ai_gen_id }} {
      padding-bottom: calc(100% / {{ block.settings.aspect_ratio_mobile }});
    }

    .ai-vimeo-video-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-vimeo-video-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.video_title != blank %}
    <h2 class="ai-vimeo-video-title-{{ ai_gen_id }}">{{ block.settings.video_title }}</h2>
  {% endif %}

  {% if block.settings.vimeo_url != blank %}
    {% assign video_id = block.settings.vimeo_url | split: '/' | last | split: '?' | first %}
    {% if video_id != blank and video_id != block.settings.vimeo_url %}
      <div class="ai-vimeo-video-container-{{ ai_gen_id }}">
        <iframe
          class="ai-vimeo-video-iframe-{{ ai_gen_id }}"
          src="https://player.vimeo.com/video/{{ video_id }}?{% if block.settings.autoplay %}autoplay=1&{% endif %}{% if block.settings.loop %}loop=1&{% endif %}{% if block.settings.muted %}muted=1&{% endif %}{% unless block.settings.show_controls %}controls=0&{% endunless %}{% unless block.settings.show_title %}title=0&{% endunless %}{% unless block.settings.show_byline %}byline=0&{% endunless %}{% unless block.settings.show_portrait %}portrait=0&{% endunless %}transparent=1"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
          loading="lazy"
          title="{% if block.settings.video_title != blank %}{{ block.settings.video_title }}{% else %}Vimeo video{% endif %}"
        ></iframe>
      </div>
    {% else %}
      <div class="ai-vimeo-video-container-{{ ai_gen_id }}">
        <div class="ai-vimeo-video-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-vimeo-video-empty-state-{{ ai_gen_id }}">
            Please enter a valid Vimeo URL
          </div>
        </div>
      </div>
    {% endif %}
  {% else %}
    <div class="ai-vimeo-video-container-{{ ai_gen_id }}">
      <div class="ai-vimeo-video-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-vimeo-video-empty-state-{{ ai_gen_id }}">
          Add a Vimeo video URL to get started
        </div>
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Vimeo video",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "text",
      "id": "vimeo_url",
      "label": "Vimeo URL",
      "info": "Example: https://vimeo.com/123456789"
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "Video title"
    },
    {
      "type": "header",
      "content": "Playback"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false,
      "info": "Video will autoplay when page loads"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop video",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Mute audio",
      "default": false
    },
    {
      "type": "header",
      "content": "Player controls"
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show player controls",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show video title in player",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_byline",
      "label": "Show author byline",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_portrait",
      "label": "Show author portrait",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 300,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Maximum width",
      "default": 800
    },
    {
      "type": "range",
      "id": "aspect_ratio",
      "min": 1.0,
      "max": 2.5,
      "step": 0.1,
      "label": "Desktop aspect ratio",
      "default": 1.8,
      "info": "Width to height ratio (1.8 = 16:9)"
    },
    {
      "type": "range",
      "id": "aspect_ratio_mobile",
      "min": 1.0,
      "max": 2.5,
      "step": 0.1,
      "label": "Mobile aspect ratio",
      "default": 1.8
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Title style"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Desktop title size",
      "default": 24
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Mobile title size",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Vimeo video"
    }
  ],
  "tag": null
}
{% endschema %}