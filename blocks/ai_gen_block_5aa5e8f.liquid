{% doc %}
  @prompt
    Create an aesthetic rich text section so i can replace the cultural sustainability content- the current one is too plane make sure it matches the page, you made the text writing very close together that it doesnt even look like words?- can u re do it better
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-rich-text-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background: {{ block.settings.background_color }};
    {% if block.settings.background_gradient != blank %}
      background: {{ block.settings.background_gradient }};
    {% endif %}
    border-radius: {{ block.settings.border_radius }}px;
    position: relative;
    overflow: hidden;
  }

  .ai-rich-text-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_width }}px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .ai-rich-text-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-rich-text-eyebrow-{{ ai_gen_id }} {
    font-family: {{ settings.type_subheading_font.family }}, {{ settings.type_subheading_font.fallback_families }};
    font-weight: {{ settings.type_subheading_font.weight }};
    font-size: {{ settings.subheading_size_desktop }}px;
    color: {{ block.settings.eyebrow_color }};
    margin-bottom: 12px;
    display: block;
    {% if settings.type_sub_uppercase %}
      text-transform: uppercase;
    {% endif %}
    letter-spacing: 0.05em;
  }

  .ai-rich-text-heading-{{ ai_gen_id }} {
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-weight: {{ settings.type_header_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    line-height: 1.2;
    {% if settings.type_header_uppercase %}
      text-transform: uppercase;
    {% endif %}
    letter-spacing: normal;
  }

  .ai-rich-text-content-{{ ai_gen_id }} {
    font-family: {{ settings.type_base_font.family }}, {{ settings.type_base_font.fallback_families }};
    font-weight: {{ settings.type_base_font.weight }};
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: {{ block.settings.line_height }};
    letter-spacing: normal;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-rich-text-content-{{ ai_gen_id }} p {
    margin-bottom: {{ block.settings.paragraph_spacing }}px;
  }

  .ai-rich-text-content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-rich-text-content-{{ ai_gen_id }} h1,
  .ai-rich-text-content-{{ ai_gen_id }} h2,
  .ai-rich-text-content-{{ ai_gen_id }} h3,
  .ai-rich-text-content-{{ ai_gen_id }} h4,
  .ai-rich-text-content-{{ ai_gen_id }} h5,
  .ai-rich-text-content-{{ ai_gen_id }} h6 {
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-weight: {{ settings.type_header_font.weight }};
    color: {{ block.settings.heading_color }};
    margin-bottom: 16px;
    line-height: 1.3;
    {% if settings.type_header_uppercase %}
      text-transform: uppercase;
    {% endif %}
    letter-spacing: normal;
  }

  .ai-rich-text-content-{{ ai_gen_id }} h1 { font-size: {{ settings.heading_large }}px; }
  .ai-rich-text-content-{{ ai_gen_id }} h2 { font-size: {{ settings.heading_medium }}px; }
  .ai-rich-text-content-{{ ai_gen_id }} h3 { font-size: {{ settings.heading_small }}px; }
  .ai-rich-text-content-{{ ai_gen_id }} h4 { font-size: {{ settings.heading_x_small }}px; }
  .ai-rich-text-content-{{ ai_gen_id }} h5 { font-size: {{ settings.heading_x_small }}px; }
  .ai-rich-text-content-{{ ai_gen_id }} h6 { font-size: {{ settings.heading_mini }}px; }

  .ai-rich-text-content-{{ ai_gen_id }} ul,
  .ai-rich-text-content-{{ ai_gen_id }} ol {
    margin-bottom: {{ block.settings.paragraph_spacing }}px;
    padding-left: 20px;
  }

  .ai-rich-text-content-{{ ai_gen_id }} li {
    margin-bottom: 8px;
  }

  .ai-rich-text-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
    transition: color 0.3s ease;
  }

  .ai-rich-text-content-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-rich-text-content-{{ ai_gen_id }} blockquote {
    border-left: 4px solid {{ block.settings.accent_color }};
    padding-left: 20px;
    margin: {{ block.settings.paragraph_spacing }}px 0;
    font-style: italic;
    color: {{ block.settings.quote_color }};
  }

  .ai-rich-text-content-{{ ai_gen_id }} strong {
    font-weight: 600;
    color: {{ block.settings.heading_color }};
  }

  .ai-rich-text-content-{{ ai_gen_id }} em {
    font-style: italic;
  }

  .ai-rich-text-decorative-element-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.decoration_top }}%;
    right: {{ block.settings.decoration_right }}%;
    width: {{ block.settings.decoration_size }}px;
    height: {{ block.settings.decoration_size }}px;
    background: {{ block.settings.decoration_color }};
    border-radius: 50%;
    opacity: {{ block.settings.decoration_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .ai-rich-text-button-wrapper-{{ ai_gen_id }} {
    margin-top: {{ block.settings.button_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-rich-text-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ settings.button_medium }}px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: 2px solid {{ block.settings.button_border_color }};
    border-radius: {% if settings.btn_border_style == 'pill' %}50px{% elsif settings.btn_border_style == 'rounded' %}8px{% else %}0{% endif %};
    font-family: {{ settings.type_btn_font.family }}, {{ settings.type_btn_font.fallback_families }};
    font-weight: {{ settings.type_btn_font.weight }};
    font-size: {{ settings.btn_size }}px;
    text-decoration: none;
    transition: all 0.3s ease;
    {% if settings.btn_caps %}
      text-transform: uppercase;
    {% endif %}
    letter-spacing: 0.05em;
  }

  .ai-rich-text-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-rich-text-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 | round }}px {{ block.settings.padding_horizontal | times: 0.7 | round }}px {{ block.settings.padding_bottom | times: 0.7 | round }}px;
    }

    .ai-rich-text-eyebrow-{{ ai_gen_id }} {
      font-size: {{ settings.subheading_size_mobile }}px;
    }

    .ai-rich-text-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 | round }}px;
    }

    .ai-rich-text-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 | round }}px;
    }

    .ai-rich-text-content-{{ ai_gen_id }} h1 { font-size: {{ settings.heading_large_mobile }}px; }
    .ai-rich-text-content-{{ ai_gen_id }} h2 { font-size: {{ settings.heading_medium_mobile }}px; }
    .ai-rich-text-content-{{ ai_gen_id }} h3 { font-size: {{ settings.heading_small_mobile }}px; }
    .ai-rich-text-content-{{ ai_gen_id }} h4 { font-size: {{ settings.heading_x_small_mobile }}px; }
    .ai-rich-text-content-{{ ai_gen_id }} h5 { font-size: {{ settings.heading_x_small_mobile }}px; }
    .ai-rich-text-content-{{ ai_gen_id }} h6 { font-size: {{ settings.heading_mini_mobile }}px; }

    .ai-rich-text-decorative-element-{{ ai_gen_id }} {
      width: {{ block.settings.decoration_size | times: 0.7 | round }}px;
      height: {{ block.settings.decoration_size | times: 0.7 | round }}px;
    }
  }
{% endstyle %}

<div class="ai-rich-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_decoration %}
    <div class="ai-rich-text-decorative-element-{{ ai_gen_id }}"></div>
  {% endif %}
  
  <div class="ai-rich-text-container-{{ ai_gen_id }}">
    {% if block.settings.eyebrow_text != blank or block.settings.heading != blank %}
      <div class="ai-rich-text-header-{{ ai_gen_id }}">
        {% if block.settings.eyebrow_text != blank %}
          <span class="ai-rich-text-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow_text }}</span>
        {% endif %}
        
        {% if block.settings.heading != blank %}
          <h2 class="ai-rich-text-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.content != blank %}
      <div class="ai-rich-text-content-{{ ai_gen_id }}">
        {{ block.settings.content }}
      </div>
    {% else %}
      <div class="ai-rich-text-content-{{ ai_gen_id }}">
        <p>Add your rich text content here. You can include headings, paragraphs, lists, links, and more to create engaging content about your cultural sustainability initiatives.</p>
      </div>
    {% endif %}

    {% if block.settings.button_text != blank and block.settings.button_url != blank %}
      <div class="ai-rich-text-button-wrapper-{{ ai_gen_id }}">
        <a href="{{ block.settings.button_url }}" class="ai-rich-text-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

