{% doc %}
  @prompt
    i want to add an image as a divider its a symbol logo - can you create a block that i can do this in an aesthetic way
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-divider-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.spacing_top }}px 0 {{ block.settings.spacing_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-image-divider-container-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
  }

  .ai-image-divider-line-{{ ai_gen_id }} {
    flex: 1;
    height: {{ block.settings.line_thickness }}px;
    background-color: {{ block.settings.line_color }};
    opacity: {{ block.settings.line_opacity | divided_by: 100.0 }};
  }

  .ai-image-divider-image-wrapper-{{ ai_gen_id }} {
    margin: 0 {{ block.settings.image_spacing }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-divider-image-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}px;
    height: auto;
    max-width: 100%;
    filter: opacity({{ block.settings.image_opacity | divided_by: 100.0 }});
  }

  .ai-image-divider-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}px;
    height: {{ block.settings.image_width | times: 0.6 }}px;
    background-color: #f4f4f4;
    border: 2px dashed #d1cdc4;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-divider-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-image-divider-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
    white-space: nowrap;
  }

  {% if block.settings.hide_lines %}
    .ai-image-divider-line-{{ ai_gen_id }} {
      display: none;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-image-divider-{{ ai_gen_id }} {
      padding: {{ block.settings.spacing_top | times: 0.7 }}px 0 {{ block.settings.spacing_bottom | times: 0.7 }}px;
    }

    .ai-image-divider-image-{{ ai_gen_id }},
    .ai-image-divider-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.image_width | times: 0.8 }}px;
    }

    .ai-image-divider-placeholder-{{ ai_gen_id }} {
      height: {{ block.settings.image_width | times: 0.8 | times: 0.6 }}px;
    }

    .ai-image-divider-image-wrapper-{{ ai_gen_id }} {
      margin: 0 {{ block.settings.image_spacing | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div
  class="ai-image-divider-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-image-divider-container-{{ ai_gen_id }}">
    {% unless block.settings.hide_lines %}
      <div class="ai-image-divider-line-{{ ai_gen_id }}"></div>
    {% endunless %}

    <div class="ai-image-divider-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.divider_image %}
        <img
          src="{{ block.settings.divider_image | image_url: width: 400 }}"
          alt="{{ block.settings.divider_image.alt | escape }}"
          class="ai-image-divider-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.image_width }}"
          height="auto"
        >
      {% else %}
        <div class="ai-image-divider-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-image-divider-empty-state-{{ ai_gen_id }}">
            Add your symbol logo
          </div>
        </div>
      {% endif %}
    </div>

    {% unless block.settings.hide_lines %}
      <div class="ai-image-divider-line-{{ ai_gen_id }}"></div>
    {% endunless %}
  </div>
</div>

{% schema %}
{
  "name": "Image divider",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "divider_image",
      "label": "Symbol logo"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 30,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Image width",
      "default": 80
    },
    {
      "type": "range",
      "id": "image_opacity",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Image opacity",
      "default": 100
    },
    {
      "type": "range",
      "id": "image_spacing",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Space around image",
      "default": 30
    },
    {
      "type": "header",
      "content": "Divider lines"
    },
    {
      "type": "checkbox",
      "id": "hide_lines",
      "label": "Hide divider lines",
      "default": false
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#d1cdc4"
    },
    {
      "type": "range",
      "id": "line_thickness",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Line thickness",
      "default": 1
    },
    {
      "type": "range",
      "id": "line_opacity",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Line opacity",
      "default": 50
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 200,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Maximum width",
      "default": 800
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top spacing",
      "default": 40
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Image divider"
    }
  ]
}
{% endschema %}