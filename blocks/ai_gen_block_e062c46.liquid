{% doc %}
  @prompt
    Create a video carousel section for the homepage that displays multiple videos in a horizontal scrolling layout. The carousel should include navigation arrows, autoplay functionality, and be responsive across all devices. Videos should be embedded (YouTube/Vimeo support) with overlay text options and smooth transitions between slides.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-carousel-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-video-carousel__container-{{ ai_gen_id }} {
    position: relative;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-video-carousel__track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
    gap: {{ block.settings.slide_gap }}px;
  }

  .ai-video-carousel__slide-{{ ai_gen_id }} {
    flex: 0 0 100%;
    position: relative;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    background-color: #000;
    aspect-ratio: 16/9;
  }

  .ai-video-carousel__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-video-carousel__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-video-carousel__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-video-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  .ai-video-carousel__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    background-color: rgba(0, 0, 0, 0.7);
    color: white;
    border-radius: 4px;
    font-size: 14px;
    text-align: center;
    pointer-events: none;
  }

  .ai-video-carousel__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: {{ block.settings.overlay_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 20px;
    z-index: 2;
  }

  .ai-video-carousel__overlay-content-{{ ai_gen_id }} {
    color: {{ block.settings.overlay_text_color }};
  }

  .ai-video-carousel__overlay-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.overlay_title_size }}px;
    font-weight: 600;
    margin: 0 0 10px;line-height: 1.2;
  }

  .ai-video-carousel__overlay-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.overlay_text_size }}px;
    margin: 0;
    line-height: 1.4;
  }

  .ai-video-carousel__nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_text_color }};
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: all 0.3s ease;opacity: 0.8;
  }

  .ai-video-carousel__nav-{{ ai_gen_id }}:hover {
    opacity: 1;
    transform: translateY(-50%) scale(1.1);
  }

  .ai-video-carousel__nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-video-carousel__nav--prev-{{ ai_gen_id }} {
    left: 20px;
  }

  .ai-video-carousel__nav--next-{{ ai_gen_id }} {
    right: 20px;
  }

  .ai-video-carousel__nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-video-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
  }

  .ai-video-carousel__dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    opacity: 0.5;
  }

  .ai-video-carousel__dot-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1.2);
  }

  @media screen and (min-width: 750px) {
    .ai-video-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.slide_gap }}px) / 2);
    }
  }

  @media screen and (min-width: 990px) {
    .ai-video-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.slide_gap | times: 2 }}px) / {{ block.settings.slides_per_view }});
    }

    .ai-video-carousel__overlay-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.overlay_title_size | times: 1.2 }}px;
    }

    .ai-video-carousel__overlay-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.overlay_text_size | times: 1.1 }}px;
    }
  }
{% endstyle %}

<video-carousel-{{ ai_gen_id }}
  class="ai-video-carousel-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.enable_autoplay }}"
  data-autoplay-delay="{{ block.settings.autoplay_delay }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-carousel__container-{{ ai_gen_id }}">
    <div class="ai-video-carousel__track-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign video_url_key = 'video_url_' | append: i
          assign video_title_key = 'video_title_' | append: i
          assign video_text_key = 'video_text_' | append: i
          assign show_overlay_key = 'show_overlay_' | append: i

          assign video_url = block.settings[video_url_key]
          assign video_title = block.settings[video_title_key]
          assign video_text = block.settings[video_text_key]
          assign show_overlay = block.settings[show_overlay_key]
        %}

        <div class="ai-video-carousel__slide-{{ ai_gen_id }}" data-slide="{{ forloop.index0 }}">
          <div class="ai-video-carousel__video-wrapper-{{ ai_gen_id }}">
            {% if video_url != blank %}
              {% liquid
                assign video_id = ''
                assign video_type = ''
                if video_url contains 'youtube.com' or video_url contains 'youtu.be'
                  assign video_type = 'youtube'
                  if video_url contains 'youtu.be/'
                    assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first
                  elsif video_url contains 'watch?v='
                    assign video_id = video_url | split: 'watch?v=' | last | split: '&' | first
                  elsif video_url contains 'embed/'
                    assign video_id = video_url | split: 'embed/' | last | split: '?' | first
                  endif
                elsif video_url contains 'vimeo.com'
                  assign video_type = 'vimeo'
                  assign url_parts = video_url | split: '/'
                  assign video_id = url_parts | last
                endif
              %}

              {% if video_type == 'youtube' and video_id != blank %}
                <iframe
                  class="ai-video-carousel__video-{{ ai_gen_id }}"
                  src="https://www.youtube.com/embed/{{ video_id }}?rel=0&modestbranding=1&autohide=1&showinfo=0&controls=1"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              {% elsif video_type == 'vimeo' and video_id != blank %}
                <iframe
                  class="ai-video-carousel__video-{{ ai_gen_id }}"
                  src="https://player.vimeo.com/video/{{ video_id }}?title=0&byline=0&portrait=0"
                  frameborder="0"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              {% endif %}

              {% if show_overlay and video_title != blank or video_text != blank %}
                <div class="ai-video-carousel__overlay-{{ ai_gen_id }}">
                  <div class="ai-video-carousel__overlay-content-{{ ai_gen_id }}">
                    {% if video_title != blank %}
                      <h3 class="ai-video-carousel__overlay-title-{{ ai_gen_id }}">{{ video_title }}</h3>
                    {% endif %}
                    {% if video_text != blank %}
                      <p class="ai-video-carousel__overlay-text-{{ ai_gen_id }}">{{ video_text }}</p>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            {% else %}
              <div class="ai-video-carousel__placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
                <div class="ai-video-carousel__empty-state-{{ ai_gen_id }}">
                  Add a video URL for slide {{ forloop.index }}
                </div>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {% if block.settings.show_navigation %}
      <button
        class="ai-video-carousel__nav-{{ ai_gen_id }} ai-video-carousel__nav--prev-{{ ai_gen_id }}"
        aria-label="Previous video"
        data-direction="prev"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15,18 9,12 15,6"></polyline>
        </svg>
      </button>

      <button
        class="ai-video-carousel__nav-{{ ai_gen_id }} ai-video-carousel__nav--next-{{ ai_gen_id }}"
        aria-label="Next video"
        data-direction="next"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9,18 15,12 9,6"></polyline>
        </svg>
      </button>
    {% endif %}

    {% if block.settings.show_dots %}
      <div class="ai-video-carousel__dots-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% liquid
            assign video_url_key = 'video_url_' | append: i
            assign video_url = block.settings[video_url_key]
          %}
          {% if video_url != blank %}
            <button
              class="ai-video-carousel__dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
              aria-label="Go to slide {{ forloop.index }}"
              data-slide="{{ forloop.index0 }}"
            ></button>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</video-carousel-{{ ai_gen_id }}><script>
  (function() {
    class VideoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayTimer = null;
        this.isAutoplayEnabled = this.dataset.autoplay === 'true';
        this.autoplayDelay = parseInt(this.dataset.autoplayDelay) * 1000;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-video-carousel__track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-video-carousel__slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-video-carousel__nav--prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-video-carousel__nav--next-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-video-carousel__dot-{{ ai_gen_id }}');

        this.validSlides = Array.from(this.slides).filter(slide => {
          return slide.querySelector('.ai-video-carousel__video-{{ ai_gen_id }}');
        });

        if (this.validSlides.length === 0) return;

        this.setupEventListeners();
        this.updateCarousel();

        if (this.isAutoplayEnabled && this.validSlides.length > 1) {
          this.startAutoplay();
        }
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.goToPrevSlide());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.goToNextSlide());
        }

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToSlide(index));
        });

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => {
          if (this.isAutoplayEnabled && this.validSlides.length > 1) {
            this.startAutoplay();
          }
        });

        window.addEventListener('resize', () => this.updateCarousel());
      }

      goToSlide(index) {
        const maxIndex = this.validSlides.length - 1;
        this.currentSlide = Math.max(0, Math.min(index, maxIndex));
        this.updateCarousel();
      }

      goToNextSlide() {
        if (this.currentSlide < this.validSlides.length - 1) {
          this.currentSlide++;} else {
          this.currentSlide = 0;
        }
        this.updateCarousel();
      }

      goToPrevSlide() {
        if (this.currentSlide > 0) {
          this.currentSlide--;
        } else {
          this.currentSlide = this.validSlides.length - 1;
        }
        this.updateCarousel();
      }

      updateCarousel() {
        const slideWidth = this.validSlides[0].offsetWidth;
        const gap = parseInt(getComputedStyle(this.track).gap) || 0;
        const offset = this.currentSlide * (slideWidth + gap);

        this.track.style.transform = `translateX(-${offset}px)`;

        this.dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === this.currentSlide);
        });

        if (this.prevButton) {
          this.prevButton.disabled = this.currentSlide === 0;
        }

        if (this.nextButton) {
          this.nextButton.disabled = this.currentSlide === this.validSlides.length - 1;
        }
      }

      startAutoplay() {
        this.stopAutoplay();
        if (this.validSlides.length > 1) {
          this.autoplayTimer = setInterval(() => {
            this.goToNextSlide();
          }, this.autoplayDelay);
        }
      }

      stopAutoplay() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
          this.autoplayTimer = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('video-carousel-{{ ai_gen_id }}', VideoCarousel{{ ai_gen_id }});
  })();
</script>

