{% doc %}
  @prompt
    logo at the above the section that says the ritual begins soon

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ritual-announcement-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    text-align: center;
    gap: {{ block.settings.spacing }}px;
  }

  .ai-ritual-logo-{{ ai_gen_id }} {
    max-width: {{ block.settings.logo_width }}px;
    width: 100%;
    height: auto;
  }

  .ai-ritual-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: {{ block.settings.logo_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
  }

  .ai-ritual-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.5;
  }

  .ai-ritual-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    margin: 0;
    letter-spacing: {{ block.settings.letter_spacing }}px;
  }

  .ai-ritual-subtext-{{ ai_gen_id }} {
    color: {{ block.settings.subtext_color }};
    font-size: {{ block.settings.subtext_size }}px;
    margin: 0;
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .ai-ritual-announcement-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.7 }}px;
      gap: {{ block.settings.spacing | times: 0.8 }}px;
    }

    .ai-ritual-logo-{{ ai_gen_id }} {
      max-width: {{ block.settings.logo_width | times: 0.8 }}px;
    }

    .ai-ritual-logo-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width | times: 0.8 }}px;
      height: {{ block.settings.logo_height | times: 0.8 }}px;
    }

    .ai-ritual-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-ritual-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div
  class="ai-ritual-announcement-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.logo %}
    <img
      src="{{ block.settings.logo | image_url: width: block.settings.logo_width }}"
      alt="{{ block.settings.logo.alt | escape }}"
      class="ai-ritual-logo-{{ ai_gen_id }}"
      loading="lazy"
      width="{{ block.settings.logo.width }}"
      height="{{ block.settings.logo.height }}"
    >
  {% else %}
    <div class="ai-ritual-logo-placeholder-{{ ai_gen_id }}">
      {{ 'image' | placeholder_svg_tag }}
    </div>
  {% endif %}

  {% if block.settings.main_text != blank %}
    <h2 class="ai-ritual-text-{{ ai_gen_id }}">{{ block.settings.main_text }}</h2>
  {% endif %}

  {% if block.settings.subtext != blank %}
    <p class="ai-ritual-subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Ritual announcement",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 150
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 30,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Logo height",
      "default": 80
    },
    {
      "type": "header",
      "content": "Text content"
    },
    {
      "type": "text",
      "id": "main_text",
      "label": "Main text",
      "default": "The ritual begins soon"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Prepare yourself for the experience"
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Main text size",
      "default": 32
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Main text weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": -2,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "label": "Letter spacing",
      "default": 1
    },
    {
      "type": "range",
      "id": "subtext_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtext size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Main text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Spacing between elements",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Ritual announcement"
    }
  ],
  "tag": null
}
{% endschema %}