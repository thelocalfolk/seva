{% doc %}
  @prompt
    Change the body text font to Sofia Pro for a specific page section containing paragraphs of content, with letter spacing set to -23, targeting paragraph text and body content with proper CSS selectors while maintaining readability and web font fallbacks

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sofia-text-section-{{ ai_gen_id }} {
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-sofia-text-section-{{ ai_gen_id }} .ai-sofia-content-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-sofia-text-section-{{ ai_gen_id }} h1,
  .ai-sofia-text-section-{{ ai_gen_id }} h2,
  .ai-sofia-text-section-{{ ai_gen_id }} h3,
  .ai-sofia-text-section-{{ ai_gen_id }} h4,
  .ai-sofia-text-section-{{ ai_gen_id }} h5,
  .ai-sofia-text-section-{{ ai_gen_id }} h6 {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    color: {{ block.settings.heading_color }};
    margin-bottom: 16px;
    line-height: 1.3;
  }

  .ai-sofia-text-section-{{ ai_gen_id }} p,
  .ai-sofia-text-section-{{ ai_gen_id }} .body-text,
  .ai-sofia-text-section-{{ ai_gen_id }} li,
  .ai-sofia-text-section-{{ ai_gen_id }} blockquote,
  .ai-sofia-text-section-{{ ai_gen_id }} .text-content {
    font-family: "Sofia Pro", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
    font-size: {{ block.settings.font_size }}px;
    letter-spacing: -0.23px;
    line-height: {{ block.settings.line_height }};
    margin-bottom: 16px;
    font-weight: {{ block.settings.font_weight }};
  }

  .ai-sofia-text-section-{{ ai_gen_id }} ul,
  .ai-sofia-text-section-{{ ai_gen_id }} ol {
    margin-bottom: 20px;
    padding-left: 24px;
  }

  .ai-sofia-text-section-{{ ai_gen_id }} li {
    margin-bottom: 8px;
  }

  .ai-sofia-text-section-{{ ai_gen_id }} blockquote {
    border-left: 4px solid {{ block.settings.accent_color }};
    padding-left: 20px;
    margin: 24px 0;
    font-style: italic;
    opacity: 0.9;
  }

  .ai-sofia-text-section-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .ai-sofia-text-section-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-sofia-text-section-{{ ai_gen_id }} strong,
  .ai-sofia-text-section-{{ ai_gen_id }} b {
    font-weight: 600;
  }

  .ai-sofia-text-section-{{ ai_gen_id }} em,
  .ai-sofia-text-section-{{ ai_gen_id }} i {
    font-style: italic;
  }

  @media screen and (max-width: 768px) {
    .ai-sofia-text-section-{{ ai_gen_id }} {
      padding: 30px 16px;
    }

    .ai-sofia-text-section-{{ ai_gen_id }} p,
    .ai-sofia-text-section-{{ ai_gen_id }} .body-text,
    .ai-sofia-text-section-{{ ai_gen_id }} li,
    .ai-sofia-text-section-{{ ai_gen_id }} blockquote,
    .ai-sofia-text-section-{{ ai_gen_id }} .text-content {
      font-size: {{ block.settings.font_size_mobile }}px;
      letter-spacing: -0.2px;
    }
  }
{% endstyle %}

<section 
  class="ai-sofia-text-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-sofia-content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2>{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.content != blank %}
      <div class="text-content">
        {{ block.settings.content }}
      </div>
    {% endif %}

    {% if block.settings.show_sample_content %}
      <p>This is a sample paragraph demonstrating the Sofia Pro font with custom letter spacing. The text should appear clean and readable while maintaining the distinctive character of the Sofia Pro typeface.</p>
      
      <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.</p>

      <blockquote>
        "This is a sample blockquote to show how the Sofia Pro font renders in different text contexts with the applied letter spacing."
      </blockquote>

      <ul>
        <li>First list item with Sofia Pro font</li>
        <li>Second list item showing consistent typography</li>
        <li>Third item demonstrating readability</li>
      </ul>

      <p>Additional paragraph content to showcase the <strong>bold text</strong> and <em>italic text</em> variations within the Sofia Pro font family. The letter spacing of -23 (converted to -0.23px) provides optimal character spacing for enhanced readability.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Sofia Pro Text Section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Text Section with Sofia Pro"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Add your custom content here. This text will be displayed using the Sofia Pro font with optimized letter spacing.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_sample_content",
      "label": "Show sample content",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "helvetica_n7"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Body font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Mobile font size",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "line_height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "label": "Line height",
      "default": 1.6
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Maximum content width",
      "default": 800
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#0066cc"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Links hover",
      "default": "#004499"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#666666"
    }
  ],
  "presets": [
    {
      "name": "Sofia Pro Text Section"
    }
  ],
  "tag": null
}
{% endschema %}