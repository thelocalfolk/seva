{% doc %}
  @prompt
    Create a flexible video embed section that accepts raw HTML embed code from video platforms like Vimeo, YouTube, etc. Include a textarea field where merchants can paste their complete embed code including iframes and scripts. The section should safely render the HTML while maintaining responsive design and include settings for section title, text content, and layout options (side-by-side or stacked). Ensure the embed code is properly sanitized and displayed without modification.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-embed-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-video-embed-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-video-embed-content-{{ ai_gen_id }} {
    display: flex;
    gap: 40px;
    align-items: {% if block.settings.vertical_alignment == 'top' %}flex-start{% elsif block.settings.vertical_alignment == 'center' %}center{% else %}flex-end{% endif %};
    {% if block.settings.layout == 'stacked' %}
      flex-direction: column;
    {% else %}
      flex-direction: row;
    {% endif %}
  }

  .ai-video-embed-text-section-{{ ai_gen_id }} {
    {% if block.settings.layout == 'side-by-side' %}
      flex: 1;
      min-width: 0;
    {% else %}
      width: 100%;
    {% endif %}
  }

  .ai-video-embed-video-section-{{ ai_gen_id }} {
    {% if block.settings.layout == 'side-by-side' %}
      flex: 1;
      min-width: 0;
    {% else %}
      width: 100%;
    {% endif %}
  }

  .ai-video-embed-title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .ai-video-embed-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-video-embed-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.aspect_ratio }};
    background-color: #f4f4f4;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-video-embed-video-wrapper-{{ ai_gen_id }} iframe,
  .ai-video-embed-video-wrapper-{{ ai_gen_id }} video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-video-embed-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #f8f8f8;
    border: 2px dashed #ddd;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-video-embed-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    color: #999;
    margin-bottom: 16px;
  }

  .ai-video-embed-placeholder-text-{{ ai_gen_id }} {
    color: #666;
    font-size: 16px;
    text-align: center;
    max-width: 280px;
    line-height: 1.4;
  }

  @media screen and (max-width: 768px) {
    .ai-video-embed-content-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 24px;
    }

    .ai-video-embed-text-section-{{ ai_gen_id }},
    .ai-video-embed-video-section-{{ ai_gen_id }} {
      flex: none;
      width: 100%;
    }

    .ai-video-embed-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-video-embed-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-video-embed-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-embed-container-{{ ai_gen_id }}">
    <div class="ai-video-embed-content-{{ ai_gen_id }}">
      {% if block.settings.title != blank or block.settings.text != blank %}
        <div class="ai-video-embed-text-section-{{ ai_gen_id }}">
          {% if block.settings.title != blank %}
            <h2 class="ai-video-embed-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
          {% endif %}
          {% if block.settings.text != blank %}
            <div class="ai-video-embed-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
          {% endif %}
        </div>
      {% endif %}

      <div class="ai-video-embed-video-section-{{ ai_gen_id }}">
        <div class="ai-video-embed-video-wrapper-{{ ai_gen_id }}">
          {% if block.settings.embed_code != blank %}
            {{ block.settings.embed_code }}
          {% else %}
            <div class="ai-video-embed-placeholder-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
              </svg>
              <div class="ai-video-embed-placeholder-text-{{ ai_gen_id }}">
                Add your video embed code to display your video here
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Video embed",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Watch our video"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Discover more about our products and services in this featured video.</p>"
    },
    {
      "type": "html",
      "id": "embed_code",
      "label": "Video embed code",
      "info": "Paste the complete embed code from YouTube, Vimeo, or other video platforms"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "side-by-side",
          "label": "Side by side"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        }
      ],
      "default": "side-by-side"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center",
      "info": "Only applies to side-by-side layout"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Video aspect ratio",
      "options": [
        {
          "value": "16/9",
          "label": "16:9 (Widescreen)"
        },
        {
          "value": "4/3",
          "label": "4:3 (Standard)"
        },
        {
          "value": "1/1",
          "label": "1:1 (Square)"
        },
        {
          "value": "9/16",
          "label": "9:16 (Vertical)"
        }
      ],
      "default": "16/9"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Video border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Video embed"
    }
  ],
  "tag": null
}
{% endschema %}