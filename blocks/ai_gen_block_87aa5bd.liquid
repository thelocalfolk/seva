{% doc %}
  @prompt
    Reduce the font size for a specific heading that says "Let's create more options. More honesty. More care. Less noise. Less toxins. Less compromise. This is my SEVA to you." making it smaller while maintaining readability and proper CSS targeting

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-seva-heading-container-{{ ai_gen_id }} {
    width: 100%;
    text-align: {{ block.settings.text_alignment }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_horizontal }}px;
  }

  .ai-seva-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size_desktop }}px;
    line-height: {{ block.settings.line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
    font-weight: {{ block.settings.font_weight }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-seva-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-seva-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-seva-heading-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.custom_text != blank %}
    <h2 class="ai-seva-heading-{{ ai_gen_id }}">
      {{ block.settings.custom_text }}
    </h2>
  {% else %}
    <h2 class="ai-seva-heading-{{ ai_gen_id }}">
      Let's create more options. More honesty. More care. Less noise. Less toxins. Less compromise. This is my SEVA to you.
    </h2>
  {% endif %}
</div>

{% schema %}
{
  "name": "SEVA heading",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "custom_text",
      "label": "Custom text",
      "info": "Leave blank to use default SEVA message"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Desktop font size",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Mobile font size",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "line_height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "label": "Line height",
      "default": 1.4
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": -2,
      "max": 4,
      "step": 0.1,
      "unit": "px",
      "label": "Letter spacing",
      "default": 0
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#212121"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "SEVA heading"
    }
  ],
  "tag": null
}
{% endschema %}