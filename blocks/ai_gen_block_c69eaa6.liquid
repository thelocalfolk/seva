{% doc %}
  @prompt
    Create a video slider section that can display multiple videos in a carousel format, supporting both YouTube and Vimeo embed codes, with navigation arrows and dots, autoplay options, and responsive design

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-slider-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-video-slider-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-video-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: #000;
  }

  .ai-video-slider-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
    width: 100%;
  }

  .ai-video-slide-{{ ai_gen_id }} {
    flex: 0 0 100%;
    position: relative;
    aspect-ratio: 16/9;
  }

  .ai-video-slide-{{ ai_gen_id }} iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .ai-video-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-video-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.5;
  }

  .ai-video-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    background-color: rgba(0, 0, 0, 0.7);
    color: white;
    font-size: 14px;
    border-radius: 4px;
    text-align: center;
    pointer-events: none;
  }

  .ai-video-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_color }};
    color: {{ block.settings.nav_icon_color }};
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: all 0.3s ease;
    opacity: {{ block.settings.nav_opacity | divided_by: 100.0 }};
  }

  .ai-video-nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_hover_color }};
    opacity: 1;
  }

  .ai-video-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-video-nav-prev-{{ ai_gen_id }} {
    left: 20px;
  }

  .ai-video-nav-next-{{ ai_gen_id }} {
    right: 20px;
  }

  .ai-video-nav-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  .ai-video-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 20px;
  }

  .ai-video-dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: none;
    background-color: {{ block.settings.dot_inactive_color }};
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-video-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.2);
  }

  .ai-video-dot-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.dot_active_color }};
  }

  {% unless block.settings.show_navigation %}
    .ai-video-nav-{{ ai_gen_id }} {
      display: none;
    }
  {% endunless %}

  {% unless block.settings.show_dots %}
    .ai-video-dots-{{ ai_gen_id }} {
      display: none;
    }
  {% endunless %}

  @media screen and (max-width: 768px) {
    .ai-video-slider-container-{{ ai_gen_id }} {
      padding: 0 15px;
    }

    .ai-video-nav-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }

    .ai-video-nav-{{ ai_gen_id }} svg {
      width: 20px;
      height: 20px;
    }

    .ai-video-nav-prev-{{ ai_gen_id }} {
      left: 10px;
    }

    .ai-video-nav-next-{{ ai_gen_id }} {
      right: 10px;
    }

    .ai-video-dot-{{ ai_gen_id }} {
      width: 10px;
      height: 10px;
    }
  }
{% endstyle %}

<video-slider-{{ ai_gen_id }}
  class="ai-video-slider-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-delay="{{ block.settings.autoplay_delay }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-slider-container-{{ ai_gen_id }}">
    <div class="ai-video-slider-wrapper-{{ ai_gen_id }}">
      <div class="ai-video-slider-track-{{ ai_gen_id }}">
        {% assign has_videos = false %}
        {% for i in (1..5) %}
          {% liquid
            assign video_url_key = 'video_url_' | append: i
            assign video_url = block.settings[video_url_key]
          %}
          
          {% if video_url != blank %}
            {% assign has_videos = true %}
            <div class="ai-video-slide-{{ ai_gen_id }}" data-slide="{{ forloop.index0 }}">
              {% liquid
                assign embed_url = ''
                if video_url contains 'youtube.com' or video_url contains 'youtu.be'
                  if video_url contains 'youtu.be'
                    assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first
                  else
                    assign video_id = video_url | split: 'v=' | last | split: '&' | first
                  endif
                  assign embed_url = 'https://www.youtube.com/embed/' | append: video_id | append: '?rel=0&modestbranding=1'
                elsif video_url contains 'vimeo.com'
                  assign video_id = video_url | split: 'vimeo.com/' | last | split: '/' | first
                  assign embed_url = 'https://player.vimeo.com/video/' | append: video_id
                endif
              %}
              
              {% if embed_url != blank %}
                <iframe
                  src="{{ embed_url }}"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              {% else %}
                <div class="ai-video-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                  <div class="ai-video-empty-state-{{ ai_gen_id }}">
                    Invalid video URL
                  </div>
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}

        {% unless has_videos %}
          <div class="ai-video-slide-{{ ai_gen_id }}" data-slide="0">
            <div class="ai-video-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-video-empty-state-{{ ai_gen_id }}">
                Add video URLs to get started
              </div>
            </div>
          </div>
        {% endunless %}
      </div>

      {% if has_videos and block.settings.show_navigation %}
        <button
          class="ai-video-nav-{{ ai_gen_id }} ai-video-nav-prev-{{ ai_gen_id }}"
          aria-label="Previous video"
          type="button"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15,18 9,12 15,6"></polyline>
          </svg>
        </button>

        <button
          class="ai-video-nav-{{ ai_gen_id }} ai-video-nav-next-{{ ai_gen_id }}"
          aria-label="Next video"
          type="button"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9,18 15,12 9,6"></polyline>
          </svg>
        </button>
      {% endif %}
    </div>

    {% if has_videos and block.settings.show_dots %}
      <div class="ai-video-dots-{{ ai_gen_id }}">
        {% assign video_count = 0 %}
        {% for i in (1..5) %}
          {% liquid
            assign video_url_key = 'video_url_' | append: i
            assign video_url = block.settings[video_url_key]
          %}
          {% if video_url != blank %}
            <button
              class="ai-video-dot-{{ ai_gen_id }} {% if video_count == 0 %}active{% endif %}"
              data-slide="{{ video_count }}"
              aria-label="Go to video {{ video_count | plus: 1 }}"
              type="button"
            ></button>
            {% assign video_count = video_count | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</video-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayTimer = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-video-slider-track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-video-slide-{{ ai_gen_id }}');
        this.prevBtn = this.querySelector('.ai-video-nav-prev-{{ ai_gen_id }}');
        this.nextBtn = this.querySelector('.ai-video-nav-next-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-video-dot-{{ ai_gen_id }}');

        this.totalSlides = this.slides.length;
        
        if (this.totalSlides <= 1) return;

        this.setupEventListeners();
        this.updateSlider();
        this.setupAutoplay();
      }

      setupEventListeners() {
        if (this.prevBtn) {
          this.prevBtn.addEventListener('click', () => this.prevSlide());
        }

        if (this.nextBtn) {
          this.nextBtn.addEventListener('click', () => this.nextSlide());
        }

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToSlide(index));
        });

        this.addEventListener('mouseenter', () => this.pauseAutoplay());
        this.addEventListener('mouseleave', () => this.resumeAutoplay());
      }

      prevSlide() {
        this.currentSlide = this.currentSlide === 0 ? this.totalSlides - 1 : this.currentSlide - 1;
        this.updateSlider();
        this.resetAutoplay();
      }

      nextSlide() {
        this.currentSlide = this.currentSlide === this.totalSlides - 1 ? 0 : this.currentSlide + 1;
        this.updateSlider();
        this.resetAutoplay();
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateSlider();
        this.resetAutoplay();
      }

      updateSlider() {
        if (!this.track) return;

        const translateX = -this.currentSlide * 100;
        this.track.style.transform = `translateX(${translateX}%)`;

        this.dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === this.currentSlide);
        });

        if (this.prevBtn) {
          this.prevBtn.disabled = false;
        }
        if (this.nextBtn) {
          this.nextBtn.disabled = false;
        }
      }

      setupAutoplay() {
        const autoplay = this.dataset.autoplay === 'true';
        const delay = parseInt(this.dataset.autoplayDelay) * 1000;

        if (autoplay && this.totalSlides > 1) {
          this.autoplayTimer = setInterval(() => {
            this.nextSlide();
          }, delay);
        }
      }

      pauseAutoplay() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
        }
      }

      resumeAutoplay() {
        this.setupAutoplay();
      }

      resetAutoplay() {
        this.pauseAutoplay();
        this.resumeAutoplay();
      }

      disconnectedCallback() {
        this.pauseAutoplay();
      }
    }

    customElements.define('video-slider-{{ ai_gen_id }}', VideoSlider{{ ai_gen_id }});
  })();
</script>

