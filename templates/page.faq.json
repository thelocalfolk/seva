        "q_delivery_time": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "How long will it take to receive my order?",
            "content": "<p>We ship with trusted carriers so your SEVA ritual arrives safely.</p><p><strong>Australia:</strong></p><ul><li><strong>Standard:</strong> 3 – 7 business days (metro is faster, regional may take longer)</li><li><strong>Express:</strong> 1 – 3 business days</li></ul><p><strong>New Zealand:</strong></p><ul><li><strong>Standard:</strong> 7 – 12 business days</li><li><strong>Express:</strong> 5 – 8 business days</li></ul><p><strong>India:</strong></p><ul><li><strong>Standard:</strong> 10 – 18 business days</li></ul><p><strong>UAE:</strong></p><ul><li><strong>Standard:</strong> 8 – 12 business days</li></ul><p><strong>Canada:</strong></p><ul><li><strong>Standard:</strong> 6 – 10 business days</li></ul><p><strong>USA:</strong></p><ul><li><strong>Standard:</strong> 6 – 10 business days</li></ul><p>During peak times (Christmas, Diwali, or public holidays), deliveries may take longer. Once dispatched, you’ll receive a tracking link to follow your parcel.</p>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": ""
          }
        },
        "q_express": {
          "type": "question",
          "settings": {
