          "settings": {
            "default_open": false,
            "title": "What should I do if my order arrives damaged?",
            "content": "<p>Please email <a href=\"mailto:info@sevabeauty.com.au\"><strong>info@sevabeauty.com.au</strong></a> with your order number and photos of the damaged item and packaging.</p><p>Our team will review your request and help make it right.</p>",
