        "text_MRincD": {
          "type": "text",
          "settings": {
            "subheading": "",
            "title": "How to use",
            "heading_font_size": "heading-medium",
            "text": "<p><strong>Prep</strong> – Begin by gently brushing your hair to detangle and release any buildup, preparing your scalp for absorption.</p><p><strong>Apply</strong> – Using 2–3 pipettes, massage the oil into your scalp with fingertips in slow, circular motions. Continue through the lengths of your hair, adding more if needed for longer or thicker strands.</p><p><strong>Treatment Time</strong> – Leave on for at least 20–30 minutes as a pre-shampoo ritual, or keep overnight for deeper nourishment.</p><p><strong>Rinse</strong> – Wash with a gentle, sulfate-free shampoo.</p><p><strong>Weekly Ritual</strong> – 1–2 times per week as a pre-shampoo or overnight treatment.</p><p><strong>For Optimal Results</strong> – Regular use helps balance the scalp, strengthen roots, and enhance shine.</p>",
            "text_font_size": "body-small",
