            "text": "<p>Massage oil into the scalp using slow, circular movements, allowing the product to meet the roots and awaken the senses.</p>"
          }
        },
        "ground": {
          "type": "step",
          "settings": {
            "title": "Ground",
            "text": "<p>Take a moment to breathe, soften and settle. Let the ritual become more than haircare — let it become a pause.</p>"
          }
        },
        "restore": {
          "type": "step",
          "settings": {
            "title": "Restore",
            "text": "<p>Leave in as part of your weekly ritual before washing, allowing the hair and scalp to feel deeply nourished and cared for.</p>"
          }
        }
      },
      "block_order": [
        "apply",
