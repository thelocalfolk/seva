        "text_LVnKrA": {
          "type": "text",
          "settings": {
            "title": "",
            "heading_font_size": "heading-x-small",
            "text": "<p>Argania Spinosa Kernel Oil (Argan Oil), Prunus Amygdalus Dulcis (Sweet Almond Oil), Caprylic/Capric Triglyceride (Fractionated Coconut Oil), Ricinus Communis (Castor) Seed Oil, Phyllanthus Emblica Fruit Oil (Amla Oil), Bacopa Monnieri Extract (Brahmi Oil), Eclipta Prostrata Extract (Bhringraj Oil), Lavandula Angustifolia Oil (Lavender), Rosmarinus Officinalis Leaf Oil (Rosemary), Citrus Aurantium Bergamia Peel Oil FCF (Bergamot FCF), Boswellia Serrata Oil (Frankincense), Tocopherol (Natural Vitamin E / D-α-Tocopherol).</p><p>Contains: Linalool, Limonene, Geraniol, Citral, Farnesol (naturally occurring in essential oils).</p>"
          }
