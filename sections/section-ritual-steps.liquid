{% comment %}
  Section: Make Haircare a Ritual — Pinned Scroll Steps
  Store: Seva (Broadcast theme)

  Matches the Figma "Make Haircare a Ritual" band: a photo on one side and, on the
  other, a heading + intro + a step timeline (Apply / Ground / Restore) + a CTA.

  Behaviour: the section PINS in the viewport and, as you keep scrolling, the
  connecting line fills top -> bottom, each dot fills, and each step's text
  brightens as it's reached. "Scroll length" controls how long it pins (a longer
  value = a slower, more deliberate reveal). Falls back to a static, fully-filled
  layout when the visitor prefers reduced motion, and to normal flow on mobile.

  Fonts inherit the theme (Cyan headings / DM Sans body). Australian English.
{% endcomment %}

{%- assign img = section.settings.image -%}

<section
  class="ritual-steps ritual-steps--img-{{ section.settings.image_side }}"
  id="section-{{ section.id }}"
  style="
    --rs-text: {{ section.settings.text_color }};
    --rs-dot: {{ section.settings.accent_color }};
    --rs-track-h: {{ section.settings.scroll_length }}vh;
    background-color: {{ section.settings.background_color }};
  "
>
  <div class="ritual-steps__track">
    <div class="ritual-steps__sticky">
      <div
        class="ritual-steps__grid"
        style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
      >
        <div class="ritual-steps__media">
          {%- if img != blank -%}
            {%- assign img_alt = img.alt | default: section.settings.heading | escape -%}
            {{
              img
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '600,800,1000,1200',
                sizes: '(max-width: 768px) 100vw, 50vw',
                alt: img_alt,
                class: 'ritual-steps__img'
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'ritual-steps__img placeholder-svg' }}
          {%- endif -%}
        </div>

        <div class="ritual-steps__content">
          {%- if section.settings.heading != blank -%}
            <h2 class="ritual-steps__title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <p class="ritual-steps__intro">{{ section.settings.intro | escape }}</p>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <ol class="ritual-steps__list">
              <span class="ritual-steps__line" aria-hidden="true"><span class="ritual-steps__line-fill"></span></span>
              {%- for block in section.blocks -%}
                {%- if block.type == 'step' -%}
                  <li class="ritual-steps__step" {{ block.shopify_attributes }}>
                    {%- if block.settings.title != blank -%}
                      <h3 class="ritual-steps__step-title">{{ block.settings.title | escape }}</h3>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <div class="ritual-steps__step-text">{{ block.settings.text }}</div>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ol>
          {%- endif -%}

          {%- if section.settings.button_text != blank -%}
            <a class="rs-btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_text | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #section-{{ section.id }}.ritual-steps { color: var(--rs-text); }
  #section-{{ section.id }} .ritual-steps__track { height: var(--rs-track-h, 250vh); position: relative; }
  #section-{{ section.id }} .ritual-steps__sticky {
    position: sticky;
    top: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
  }
  #section-{{ section.id }} .ritual-steps__grid {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
  }
  #section-{{ section.id }}.ritual-steps--img-right .ritual-steps__media { order: 2; }
  #section-{{ section.id }} .ritual-steps__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  #section-{{ section.id }} .ritual-steps__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #section-{{ section.id }} .ritual-steps__content {
    padding-right: var(--LAYOUT-OUTER, 48px);
    max-width: 620px;
  }
  #section-{{ section.id }}.ritual-steps--img-right .ritual-steps__content {
    padding-right: 0;
    padding-left: var(--LAYOUT-OUTER, 48px);
  }
  #section-{{ section.id }} .ritual-steps__title {
    font-family: var(--FONT-STACK-HEADING);
    font-weight: var(--FONT-WEIGHT-HEADING, 400);
    font-size: var(--FONT-HEADING-MEDIUM, 30px);
    text-transform: uppercase;
    color: var(--rs-text);
    margin: 0 0 16px;
  }
  #section-{{ section.id }} .ritual-steps__intro {
    font-family: var(--FONT-STACK-BODY);
    font-size: 14px;
    color: var(--rs-text);
    margin: 0 0 36px;
  }
  #section-{{ section.id }} .ritual-steps__list {
    list-style: none;
    margin: 0 0 36px;
    padding: 0;
    position: relative;
  }
  /* Connecting line + scroll-driven fill (JS sets top/height + --rs-progress) */
  #section-{{ section.id }} .ritual-steps__line {
    position: absolute;
    left: 5px;
    top: 6px;
    width: 1px;
    background: var(--rs-track-color, rgba(24, 46, 33, 0.18));
  }
  #section-{{ section.id }} .ritual-steps__line-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: calc(var(--rs-progress, 0) * 100%);
    background: var(--rs-dot);
    transition: height 0.12s linear;
  }
  #section-{{ section.id }} .ritual-steps__step {
    position: relative;
    padding: 0 0 32px 30px;
  }
  #section-{{ section.id }} .ritual-steps__step:last-child { padding-bottom: 0; }
  #section-{{ section.id }} .ritual-steps__step::before {
    content: "";
    position: absolute;
    left: 0;
    top: 4px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: {{ section.settings.background_color }};
    border: 1px solid var(--rs-dot);
    transition: background-color 0.3s ease;
    z-index: 1;
  }
  #section-{{ section.id }} .ritual-steps__step.is-active::before { background: var(--rs-dot); }
  #section-{{ section.id }} .ritual-steps__step-title,
  #section-{{ section.id }} .ritual-steps__step-text {
    opacity: 0.28;
    transition: opacity 0.45s ease;
  }
  #section-{{ section.id }} .ritual-steps__step.is-active .ritual-steps__step-title,
  #section-{{ section.id }} .ritual-steps__step.is-active .ritual-steps__step-text { opacity: 1; }
  #section-{{ section.id }} .ritual-steps__step-title {
    font-family: var(--FONT-STACK-HEADING);
    font-weight: var(--FONT-WEIGHT-HEADING, 400);
    font-size: var(--FONT-HEADING-SMALL, 20px);
    color: var(--rs-text);
    margin: 0 0 8px;
  }
  #section-{{ section.id }} .ritual-steps__step-text {
    font-family: var(--FONT-STACK-BODY);
    font-size: 13px;
    line-height: 1.6;
    color: var(--rs-text);
  }
  #section-{{ section.id }} .ritual-steps__step-text p { margin: 0; }
  #section-{{ section.id }} .rs-btn {
    display: inline-block;
    border: 1px solid var(--rs-text);
    color: var(--rs-text);
    background: transparent;
    font-family: var(--FONT-STACK-BODY);
    font-size: 14px;
    padding: 15px 40px;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  #section-{{ section.id }} .rs-btn:hover { background: var(--rs-text); color: #fff; }

  /* Mobile: drop the pin, stack normally */
  @media (max-width: 768px) {
    #section-{{ section.id }} .ritual-steps__track { height: auto; }
    #section-{{ section.id }} .ritual-steps__sticky { position: static; min-height: 0; display: block; }
    #section-{{ section.id }} .ritual-steps__grid { grid-template-columns: 1fr; gap: 28px; }
    /* Drop the large top padding on mobile so the image sits close to the
       section above (the inline padding_top is a desktop value) */
    #section-{{ section.id }} .ritual-steps__grid { padding-top: 0 !important; }
    /* aspect-ratio grid item blows out its cell when the grid centres it vertically —
       pin width to the column and let height follow the 1:1 ratio */
    #section-{{ section.id }} .ritual-steps__media { width: 100%; height: auto; }
    #section-{{ section.id }}.ritual-steps--img-right .ritual-steps__media { order: 0; }
    #section-{{ section.id }} .ritual-steps__content,
    #section-{{ section.id }}.ritual-steps--img-right .ritual-steps__content {
      padding-left: var(--LAYOUT-OUTER-SMALL, 16px);
      padding-right: var(--LAYOUT-OUTER-SMALL, 16px);
    }
  }
</style>

<script>
  (function () {
    var section = document.getElementById('section-{{ section.id }}');
    if (!section) return;
    var track = section.querySelector('.ritual-steps__track');
    var list = section.querySelector('.ritual-steps__list');
    var line = section.querySelector('.ritual-steps__line');
    var steps = section.querySelectorAll('.ritual-steps__step');
    if (!track || !list || !line || !steps.length) return;

    // Reduced motion: everything filled, no scroll animation.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      section.style.setProperty('--rs-progress', '1');
      for (var i = 0; i < steps.length; i++) steps[i].classList.add('is-active');
      return;
    }

    var n = steps.length;
    var ticking = false;
    function update() {
      ticking = false;
      var vh = window.innerHeight || document.documentElement.clientHeight;

      // Line geometry: span from the first dot centre to the last dot centre.
      var lr = list.getBoundingClientRect();
      var firstDot = steps[0].getBoundingClientRect().top - lr.top + 9;
      var lastDot = steps[n - 1].getBoundingClientRect().top - lr.top + 9;
      line.style.top = firstDot + 'px';
      line.style.height = Math.max(1, lastDot - firstDot) + 'px';

      // Progress = how far we've scrolled through the pinned track (0 -> 1).
      var tr = track.getBoundingClientRect();
      var scrollable = Math.max(1, tr.height - vh);
      var p = (-tr.top) / scrollable;
      p = Math.max(0, Math.min(1, p));
      section.style.setProperty('--rs-progress', p.toFixed(3));

      // Activate each step as the fill reaches its dot.
      for (var i = 0; i < n; i++) {
        var thresh = n > 1 ? (i / (n - 1)) : 0;
        if (p + 0.02 >= thresh) steps[i].classList.add('is-active');
        else steps[i].classList.remove('is-active');
      }
    }
    function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    window.addEventListener('load', update);
    update();
  })();
</script>

{% schema %}
{
  "name": "Make Haircare a Ritual",
  "tag": "section",
  "class": "section-ritual-steps",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side (desktop)",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make haircare a ritual."
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro line",
      "default": "SEVA was born from a deeply personal journey back to ancestral care."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Explore the Ritual"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Scroll behaviour"
    },
    {
      "type": "range",
      "id": "scroll_length",
      "label": "Scroll length (how long it pins)",
      "info": "Higher = slower, longer reveal. Set to 100 for no pinning.",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "vh",
      "default": 260
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & buttons",
      "default": "#182e21"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Timeline dots & rule",
      "default": "#e0c3bd"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step title",
          "default": "Apply"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Step text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Make Haircare a Ritual",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "footer"]
  }
}
{% endschema %}
