{% comment %}
  Section: Visible Results — Review Cards
  Store: Seva (Broadcast theme)

  Matches the Figma "Ayurvedic Ingredients. Visible Results." band: a heading with
  a row of review cards, each with an image (e.g. before/after), a star rating, a
  quote and a name.

  - "Review" blocks: image, rating (1-5), quote, name — all editable.
  - Fonts inherit the theme (Cyan headings / DM Sans body). Australian English.
  - When a review app (Judge.me is installed) is wired up later, these can be
    swapped for live reviews; for now they're curated/editable.

  Layout: a horizontal scroll-snap carousel. It is always swipeable/draggable
  (native overflow scrolling — no library), with optional auto-scroll, optional
  arrows, and a "cards per view" setting. Auto-scroll pauses on hover, on focus
  and while the visitor is scrolling it themselves, and is skipped entirely for
  visitors who prefer reduced motion.
{% endcomment %}

{%- liquid
  assign per_view = section.settings.cards_per_view | default: 3
  assign mobile_width = section.settings.mobile_card_width | default: 85
  assign autoplay = section.settings.autoplay
  assign autoplay_speed = section.settings.autoplay_speed | default: 4
-%}

<section
  class="visible-results"
  id="section-{{ section.id }}"
  style="
    --vr-text: {{ section.settings.text_color }};
    --vr-card-bg: {{ section.settings.card_color }};
    --vr-gap: {{ section.settings.card_gap }}px;
    --vr-media-ratio: 100 / {{ section.settings.image_height | default: 67 }};
    --vr-per-view: {{ per_view }};
    --vr-mobile-width: {{ mobile_width }}%;
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="visible-results__inner">
    <div class="visible-results__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="visible-results__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.show_arrows -%}
        <div class="visible-results__arrows">
          <button type="button" class="visible-results__arrow" data-vr-prev aria-label="Previous reviews">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path d="M15 4 7 12l8 8" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </button>
          <button type="button" class="visible-results__arrow" data-vr-next aria-label="Next reviews">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path d="M9 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </button>
        </div>
      {%- endif -%}
    </div>

    <div
      class="visible-results__track"
      data-vr-track
      {% if autoplay %}data-vr-autoplay="{{ autoplay_speed }}"{% endif %}
      tabindex="0"
      role="region"
      aria-label="Customer reviews"
    >
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          {%- assign rv_img = block.settings.image -%}
          <div class="vr-card" data-vr-card {{ block.shopify_attributes }}>
            <div class="vr-card__media">
              {%- if rv_img != blank -%}
                {%- assign rv_alt = rv_img.alt | default: block.settings.name | escape -%}
                {{
                  rv_img
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '400,600,800,900',
                    sizes: '(max-width: 768px) 85vw, 33vw',
                    alt: rv_alt,
                    class: 'vr-card__img'
                }}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'vr-card__img placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="vr-card__body">
              {%- assign rating = block.settings.rating | plus: 0 -%}
              <div class="vr-card__stars" aria-label="{{ rating }} out of 5 stars">
                {%- for i in (1..5) -%}
                  {%- if i <= rating -%}★{%- else -%}☆{%- endif -%}
                {%- endfor -%}
              </div>
              {%- if block.settings.quote != blank -%}
                <blockquote class="vr-card__quote">{{ block.settings.quote }}</blockquote>
              {%- endif -%}
              {%- if block.settings.name != blank -%}
                <p class="vr-card__name">{{ block.settings.name | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #section-{{ section.id }}.visible-results { color: var(--vr-text); }
  #section-{{ section.id }} .visible-results__inner {
    padding-left: var(--LAYOUT-OUTER, 48px);
    padding-right: var(--LAYOUT-OUTER, 48px);
  }
  #section-{{ section.id }} .visible-results__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin: 0 0 24px;
  }
  #section-{{ section.id }} .visible-results__title {
    font-family: var(--FONT-STACK-HEADING);
    font-weight: var(--FONT-WEIGHT-HEADING, 400);
    font-size: var(--FONT-HEADING-SMALL, 20px);
    color: var(--vr-text);
    margin: 0;
  }
  #section-{{ section.id }} .visible-results__arrows {
    display: flex;
    gap: 8px;
    flex: 0 0 auto;
  }
  #section-{{ section.id }} .visible-results__arrow {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid currentColor;
    border-radius: 50%;
    color: var(--vr-text);
    cursor: pointer;
    padding: 0;
    transition: opacity 0.2s ease;
  }
  #section-{{ section.id }} .visible-results__arrow[disabled] {
    opacity: 0.3;
    cursor: default;
  }

  /* The carousel. Native horizontal scrolling with snap points — swipeable on
     touch, drag/trackpad on desktop, no JS needed for the scrolling itself. */
  #section-{{ section.id }} .visible-results__track {
    display: flex;
    gap: var(--vr-gap);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    align-items: stretch;
  }
  #section-{{ section.id }} .visible-results__track::-webkit-scrollbar { display: none; }
  #section-{{ section.id }} .visible-results__track:focus-visible {
    outline: 2px solid var(--vr-text);
    outline-offset: 4px;
  }
  #section-{{ section.id }} .vr-card {
    display: flex;
    flex-direction: column;
    background: var(--vr-card-bg);
    scroll-snap-align: start;
    flex: 0 0 calc((100% - (var(--vr-per-view) - 1) * var(--vr-gap)) / var(--vr-per-view));
  }
  /* Image height is driven by the "Image height" setting (% of card width).
     67% = the original 3:2 shape; higher numbers make the images taller. */
  #section-{{ section.id }} .vr-card__media {
    aspect-ratio: var(--vr-media-ratio, 3 / 2);
    overflow: hidden;
    font-size: 0;
  }
  #section-{{ section.id }} .vr-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #section-{{ section.id }} .vr-card__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px 24px 28px;
    flex: 1 1 auto;
  }
  #section-{{ section.id }} .vr-card__stars {
    font-size: 13px;
    letter-spacing: 2px;
    color: var(--vr-text);
  }
  #section-{{ section.id }} .vr-card__quote {
    font-family: var(--FONT-STACK-HEADING);
    font-weight: var(--FONT-WEIGHT-HEADING, 400);
    font-size: 18px;
    line-height: 1.35;
    color: var(--vr-text);
    margin: 0;
    padding-left: 0;
    border-left: 0;
  }
  #section-{{ section.id }} .vr-card__name {
    font-family: var(--FONT-STACK-BODY);
    font-size: 12px;
    color: var(--vr-text);
    opacity: 1;
    margin: auto 0 0;
  }
  @media (max-width: 768px) {
    #section-{{ section.id }} .visible-results__inner {
      padding-left: var(--LAYOUT-OUTER-SMALL, 16px);
      padding-right: var(--LAYOUT-OUTER-SMALL, 16px);
    }
    /* One card per screen with a sliver of the next showing, so it reads as swipeable */
    #section-{{ section.id }} .vr-card {
      flex: 0 0 var(--vr-mobile-width);
    }
    #section-{{ section.id }} .visible-results__arrows { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    #section-{{ section.id }} .visible-results__track { scroll-behavior: auto; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('section-{{ section.id }}');
    if (!root || root.dataset.vrInit === 'true') return;
    root.dataset.vrInit = 'true';

    var track = root.querySelector('[data-vr-track]');
    if (!track) return;

    var prev = root.querySelector('[data-vr-prev]');
    var next = root.querySelector('[data-vr-next]');
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function step() {
      var card = track.querySelector('[data-vr-card]');
      if (!card) return track.clientWidth;
      var styles = getComputedStyle(track);
      var gap = parseFloat(styles.columnGap || styles.gap) || 0;
      return card.getBoundingClientRect().width + gap;
    }

    function atEnd() {
      return track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    }

    function updateArrows() {
      if (prev) prev.disabled = track.scrollLeft <= 2;
      if (next) next.disabled = atEnd();
    }

    if (prev) {
      prev.addEventListener('click', function () {
        track.scrollBy({ left: -step(), behavior: 'smooth' });
      });
    }
    if (next) {
      next.addEventListener('click', function () {
        track.scrollBy({ left: step(), behavior: 'smooth' });
      });
    }

    track.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);
    updateArrows();

    /* Optional auto-scroll. Pauses on hover, on keyboard focus, and while the
       visitor is interacting with the track themselves. */
    var speed = parseFloat(track.dataset.vrAutoplay);
    if (!speed || reduceMotion) return;

    var timer = null;
    var paused = false;

    function advance() {
      if (paused) return;
      if (atEnd()) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: step(), behavior: 'smooth' });
      }
    }

    function start() { if (!timer) timer = setInterval(advance, speed * 1000); }
    function stop() { clearInterval(timer); timer = null; }

    ['mouseenter', 'focusin', 'touchstart', 'pointerdown'].forEach(function (evt) {
      track.addEventListener(evt, function () { paused = true; }, { passive: true });
    });
    ['mouseleave', 'focusout', 'touchend', 'pointerup'].forEach(function (evt) {
      track.addEventListener(evt, function () { paused = false; }, { passive: true });
    });

    /* Only run while the section is actually on screen */
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) { start(); } else { stop(); }
      }, { threshold: 0.2 }).observe(root);
    } else {
      start();
    }
  })();
</script>

{% schema %}
{
  "name": "Visible Results",
  "tag": "section",
  "class": "section-visible-results",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ayurvedic Ingredients. Visible Results."
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#f5f2ec"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#182e21"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "range",
      "id": "cards_per_view",
      "label": "Cards per view (desktop)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "label": "Card width (mobile)",
      "info": "Under 100% leaves a sliver of the next card showing, which hints that it swipes.",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows (desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Scroll automatically",
      "info": "Pauses on hover and while the visitor is swiping. Always off for visitors who prefer reduced motion.",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds between cards",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height (% of card width)",
      "info": "67% matches the original 3:2 shape. Higher = taller images.",
      "min": 50,
      "max": 150,
      "step": 1,
      "unit": "%",
      "default": 67
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Visible Results",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "footer"]
  }
}
{% endschema %}
