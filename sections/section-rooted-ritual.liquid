{% comment %}
  Section: Rooted in Ritual — Video Testimonial Slider
  Store: Seva (Broadcast theme)

  Matches the Figma "Rooted in Ritual" band: a blush panel with a text column on
  the left (eyebrow / heading / body / ‹ › arrows + pagination) and a 2-up video
  slider on the right. Click a tile to play.

  - "Video" blocks: a hosted video + optional poster image.
  - Fonts inherit the theme (Cyan headings / DM Sans body). Australian English.
{% endcomment %}

<section
  class="rooted-ritual"
  id="section-{{ section.id }}"
  style="
    --rr-text: {{ section.settings.text_color }};
    --rr-gap: {{ section.settings.gap }}px;
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="rr-grid">
    <div class="rr-text">
      <div class="rr-text__top">
        {%- if section.settings.eyebrow != blank -%}
          <p class="rr-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="rr-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      <div class="rr-text__bottom">
        {%- if section.settings.body != blank -%}
          <div class="rr-body">{{ section.settings.body }}</div>
        {%- endif -%}
        <div class="rr-nav">
          <button class="rr-arrow rr-prev" type="button" aria-label="Previous">&#8249;</button>
          <button class="rr-arrow rr-next" type="button" aria-label="Next">&#8250;</button>
          <span class="rr-count"><span class="rr-count__current">1</span> / <span class="rr-count__total">1</span></span>
        </div>
      </div>
    </div>

    <div class="rr-slider">
      <div class="rr-track">
        {%- for block in section.blocks -%}
          {%- if block.type == 'video' and block.settings.video != blank -%}
            <div class="rr-tile" {{ block.shopify_attributes }}>
              {%- assign poster = block.settings.poster | default: block.settings.video.preview_image -%}
              <video
                class="rr-video"
                playsinline
                preload="none"
                {% if poster != blank %}poster="{{ poster | image_url: width: 800 }}"{% endif %}
              >
                {%- for src in block.settings.video.sources -%}
                  <source src="{{ src.url }}" type="{{ src.mime_type }}">
                {%- endfor -%}
              </video>
              <button class="rr-play" type="button" aria-label="Play video">
                <span class="rr-play__icon"></span>
              </button>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<style>
  #section-{{ section.id }}.rooted-ritual { color: var(--rr-text); overflow: hidden; }
  #section-{{ section.id }} .rr-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(24px, 4vw, 64px);
    align-items: stretch;
    padding-left: var(--LAYOUT-OUTER, 48px);
  }
  #section-{{ section.id }} .rr-text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 8px 0 4px;
    max-width: 460px;
  }
  #section-{{ section.id }} .rr-eyebrow {
    font-family: var(--FONT-STACK-BODY);
    font-size: 13px;
    color: var(--rr-text);
    margin: 0 0 20px;
  }
  #section-{{ section.id }} .rr-heading {
    font-family: var(--FONT-STACK-HEADING);
    font-weight: var(--FONT-WEIGHT-HEADING, 400);
    font-size: var(--FONT-HEADING-MEDIUM, 30px);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--rr-text);
    margin: 0;
  }
  #section-{{ section.id }} .rr-body {
    font-family: var(--FONT-STACK-BODY);
    font-size: 14px;
    line-height: 1.6;
    color: var(--rr-text);
    margin: 0 0 28px;
  }
  #section-{{ section.id }} .rr-body p { margin: 0 0 12px; }
  #section-{{ section.id }} .rr-body p:last-child { margin-bottom: 0; }
  #section-{{ section.id }} .rr-nav { display: flex; align-items: center; gap: 14px; }
  #section-{{ section.id }} .rr-arrow {
    width: 44px;
    height: 44px;
    border: 1px solid var(--rr-text);
    background: transparent;
    color: var(--rr-text);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }
  #section-{{ section.id }} .rr-arrow:hover { background: var(--rr-text); color: #fff; }
  #section-{{ section.id }} .rr-arrow[disabled] { opacity: 0.35; cursor: default; }
  #section-{{ section.id }} .rr-arrow[disabled]:hover { background: transparent; color: var(--rr-text); }
  #section-{{ section.id }} .rr-count {
    font-family: var(--FONT-STACK-BODY);
    font-size: 13px;
    color: var(--rr-text);
    margin-left: 6px;
  }

  #section-{{ section.id }} .rr-slider { overflow: hidden; }
  #section-{{ section.id }} .rr-track {
    display: flex;
    gap: var(--rr-gap, 16px);
    transition: transform 0.5s ease;
  }
  #section-{{ section.id }} .rr-tile {
    position: relative;
    flex: 0 0 calc((100% - var(--rr-gap, 16px)) / 2);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.06);
  }
  #section-{{ section.id }} .rr-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #section-{{ section.id }} .rr-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 54px;
    height: 54px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.9);
    background: rgba(0, 0, 0, 0.15);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.25s ease;
  }
  #section-{{ section.id }} .rr-play__icon {
    width: 0;
    height: 0;
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
    border-left: 13px solid #fff;
    margin-left: 3px;
  }
  #section-{{ section.id }} .rr-tile.is-playing .rr-play { opacity: 0; pointer-events: none; }

  @media (max-width: 768px) {
    /* Stack to a single centred column. Flatten the text wrappers with
       display:contents so eyebrow/heading/body/nav become direct flex items
       of the grid and can be ordered around the video slider. */
    #section-{{ section.id }} .rr-grid {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      padding-left: var(--LAYOUT-OUTER-SMALL, 16px);
      padding-right: var(--LAYOUT-OUTER-SMALL, 16px);
      gap: 0;
    }
    #section-{{ section.id }} .rr-text,
    #section-{{ section.id }} .rr-text__top,
    #section-{{ section.id }} .rr-text__bottom { display: contents; }

    /* Centre all the copy */
    #section-{{ section.id }} .rr-eyebrow,
    #section-{{ section.id }} .rr-heading,
    #section-{{ section.id }} .rr-body { text-align: center; }

    /* Order + spacing between the stacked elements */
    #section-{{ section.id }} .rr-eyebrow { order: 1; margin: 0 0 16px; }
    #section-{{ section.id }} .rr-heading { order: 2; margin: 0 0 22px; }
    #section-{{ section.id }} .rr-body   { order: 3; margin: 0 0 34px; }
    #section-{{ section.id }} .rr-slider { order: 4; margin: 0 0 26px; }
    #section-{{ section.id }} .rr-nav    { order: 5; justify-content: center; }

    #section-{{ section.id }} .rr-tile { flex: 0 0 calc((100% - var(--rr-gap, 16px)) / 1.15); }
  }
</style>

<script>
  (function () {
    var section = document.getElementById('section-{{ section.id }}');
    if (!section) return;
    var track = section.querySelector('.rr-track');
    var tiles = section.querySelectorAll('.rr-tile');
    var prev = section.querySelector('.rr-prev');
    var next = section.querySelector('.rr-next');
    var curEl = section.querySelector('.rr-count__current');
    var totEl = section.querySelector('.rr-count__total');
    if (!track || !tiles.length) return;

    function perView() { return window.innerWidth > 768 ? 2 : 1; }
    var page = 0;
    function pages() { return Math.max(1, Math.ceil(tiles.length / perView())); }

    function render() {
      var total = pages();
      if (page > total - 1) page = total - 1;
      var target = tiles[Math.min(page * perView(), tiles.length - 1)];
      track.style.transform = 'translateX(' + (-target.offsetLeft) + 'px)';
      if (curEl) curEl.textContent = page + 1;
      if (totEl) totEl.textContent = total;
      if (prev) prev.disabled = page === 0;
      if (next) next.disabled = page >= total - 1;
    }
    if (prev) prev.addEventListener('click', function () { if (page > 0) { page--; render(); } });
    if (next) next.addEventListener('click', function () { if (page < pages() - 1) { page++; render(); } });
    window.addEventListener('resize', render, { passive: true });
    window.addEventListener('load', render);

    // Click a tile to play; pause the others.
    for (var i = 0; i < tiles.length; i++) {
      (function (tile) {
        var video = tile.querySelector('video');
        var btn = tile.querySelector('.rr-play');
        if (!video || !btn) return;
        btn.addEventListener('click', function () {
          for (var j = 0; j < tiles.length; j++) {
            var v = tiles[j].querySelector('video');
            if (v && v !== video) { v.pause(); tiles[j].classList.remove('is-playing'); }
          }
          video.setAttribute('controls', '');
          tile.classList.add('is-playing');
          var p = video.play();
          if (p && p.catch) p.catch(function () {});
        });
        video.addEventListener('pause', function () { tile.classList.remove('is-playing'); video.removeAttribute('controls'); });
      })(tiles[i]);
    }
    render();
  })();
</script>

{% schema %}
{
  "name": "Rooted in Ritual",
  "tag": "section",
  "class": "section-rooted-ritual",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Seva + You"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rooted in Ritual"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "header",
      "content": "Colours & Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#e6cfca"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & controls",
      "default": "#182e21"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between videos",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 90
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster image",
          "info": "Optional. Shown before play."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rooted in Ritual",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "footer"]
  }
}
{% endschema %}
