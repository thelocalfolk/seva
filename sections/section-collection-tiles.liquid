{% comment %}
  Section: Collection Tiles (OILS / TOOLS split)
  Store: Seva (Broadcast theme)

  Full-bleed split of image tiles, each with a centred overlay label linking to a
  collection (or any URL). Matches the Figma "OILS / TOOLS" band.

  - "Tile" blocks: image, label, link. Two by default; add more to make a row.
  - Fonts inherit the theme (Cyan headings). Australian English.
{% endcomment %}

<section
  class="collection-tiles"
  id="section-{{ section.id }}"
  style="
    --ct-gap: {{ section.settings.gap }}px;
    --ct-height: {{ section.settings.tile_height }}px;
    --ct-label: {{ section.settings.label_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="collection-tiles__grid" style="--ct-columns: {{ section.blocks.size | at_least: 1 }};">
    {%- for block in section.blocks -%}
      {%- if block.type == 'tile' -%}
        {%- assign tile_img = block.settings.image -%}
        <a class="ct-tile" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="ct-tile__media">
            {%- if tile_img != blank -%}
              {%- assign tile_alt = tile_img.alt | default: block.settings.label | escape -%}
              {{
                tile_img
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '600,800,1000,1200',
                  sizes: '(max-width: 768px) 100vw, 50vw',
                  alt: tile_alt,
                  class: 'ct-tile__img'
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'ct-tile__img placeholder-svg' }}
            {%- endif -%}
          </div>
          {%- if block.settings.label != blank -%}
            <span class="ct-tile__label">{{ block.settings.label | escape }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<style>
  #section-{{ section.id }} .collection-tiles__grid {
    display: grid;
    grid-template-columns: repeat(var(--ct-columns, 2), 1fr);
    gap: var(--ct-gap, 4px);
  }
  #section-{{ section.id }} .ct-tile {
    position: relative;
    display: block;
    height: var(--ct-height, 640px);
    overflow: hidden;
    text-decoration: none;
  }
  #section-{{ section.id }} .ct-tile__media { position: absolute; inset: 0; }
  #section-{{ section.id }} .ct-tile__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  #section-{{ section.id }} .ct-tile:hover .ct-tile__img { transform: scale(1.03); }
  #section-{{ section.id }} .ct-tile__label {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--FONT-STACK-HEADING);
    font-weight: var(--FONT-WEIGHT-HEADING, 400);
    font-size: var(--FONT-HEADING-X-LARGE, 50px);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ct-label, #f5f5f5);
    text-align: center;
    z-index: 1;
  }
  @media (max-width: 768px) {
    #section-{{ section.id }} .collection-tiles__grid { grid-template-columns: 1fr; }
    #section-{{ section.id }} .ct-tile { height: 62vh; }
    #section-{{ section.id }} .ct-tile__label { font-size: var(--FONT-HEADING-LARGE, 40px); }
  }
</style>

{% schema %}
{
  "name": "Collection Tiles",
  "tag": "section",
  "class": "section-collection-tiles",
  "settings": [
    {
      "type": "range",
      "id": "tile_height",
      "label": "Tile height (desktop)",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between tiles",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label colour",
      "default": "#f5f5f5"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Oils"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Tiles",
      "blocks": [
        { "type": "tile", "settings": { "label": "Oils" } },
        { "type": "tile", "settings": { "label": "Tools" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "footer"]
  }
}
{% endschema %}
